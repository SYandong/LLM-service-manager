    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(command, 124, exc.stdout or "", exc.stderr or "command timed out")


def unit_exists(unit_service: str) -> bool:
    result = run_checked(["systemctl", "show", "-p", "LoadState", "--value", unit_service])
    if result.returncode != 0 or not result.stdout.strip():
        raise LaunchError(f"could not inspect existing unit {unit_service}")
    return result.returncode == 0 and result.stdout.strip() not in {"", "not-found"}


def unit_runtime_state(unit_service: str) -> str:
    result = run_checked(["systemctl", "is-active", unit_service])
    state = result.stdout.strip()
    if result.returncode == 0:
        return "active"
    if state in {"inactive", "failed"}:
        return "inactive"
    return "unknown"


def release_safe(unit_service: str) -> bool:
    result = run_checked(
        ["systemctl", "show", "-p", "LoadState", "-p", "ActiveState", "-p", "MainPID", "-p", "ControlGroup", unit_service]
    )
    if result.returncode != 0:
        return False
    values = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if values.get("LoadState") == "not-found":
        return True
    return (values.get("LoadState") == "loaded"
            and values.get("ActiveState") in {"inactive", "failed"}
            and values.get("MainPID") == "0"
            and values.get("ControlGroup") == "")


def unit_has_lease(unit_service: str, lease_id: str) -> bool:
    result = run_checked(["systemctl", "show", "-p", "Environment", "--value", unit_service])
    if result.returncode != 0:
        return False
    try:
        environment = shlex.split(result.stdout)
    except ValueError:
        return False
    return f"LLMSVC_LEASE_ID={lease_id}" in environment


def stop_owned_unit(unit_service: str, lease_id: str) -> bool:
    if not unit_has_lease(unit_service, lease_id):
        log("stop_skipped_no_ownership_evidence", unit=unit_service, lease_id=lease_id)
        return False
    result = run_checked(["systemctl", "stop", unit_service])
    log("owned_unit_stop", unit=unit_service, lease_id=lease_id, returncode=result.returncode)
    return result.returncode == 0


def build_systemd_run(
    config: dict[str, Any],
    unit: str,
    gpu: str,
    lease_id: str,
    model: str,
    command: list[str],
) -> list[str]:
    systemd_config = dict(config.get("systemd_run", {}))
    cmd = ["systemd-run", f"--unit={unit}"]
    if systemd_config.get("collect", True):
        cmd.append("--collect")
    if systemd_config.get("quiet", True):
        cmd.append("--quiet")
    for key, value in dict(systemd_config.get("properties", {})).items():
        cmd.append(f"--property={key}={value}")
    environment_file = systemd_config.get("environment_file")
    if environment_file:
        cmd.append(f"--property=EnvironmentFile={environment_file}")
    cmd.extend(
        [
            f"--setenv=CUDA_VISIBLE_DEVICES={gpu}",
            f"--setenv=LLMSVC_LEASE_ID={lease_id}",
            f"--setenv=LLMSVC_MODEL={model}",
            "--",
        ]
    )
    cmd.extend(command)
    return cmd


