        time.sleep(poll)


@contextlib.contextmanager
def model_lock(config: dict[str, Any], model: str, dry_run: bool) -> Iterator[None]:
    if dry_run:
        yield
        return
    lock_dir = Path(str(config["lock_dir"]))
    lock_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
    digest = hashlib.sha256(model.encode("utf-8")).hexdigest()[:16]
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", model)[:80] or "model"
    lock_path = lock_dir / f"{safe}.{digest}.lock"
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o644)
    try:
        deadline = time.monotonic() + float(config["lock_timeout_seconds"])
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as exc:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise LaunchError(f"timed out waiting for model lock {model}", 75) from exc
                time.sleep(min(0.1, remaining))
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


