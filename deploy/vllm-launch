    lease_id = body.get("lease_id")
    if type(gpu) is not int or gpu < 0 or not isinstance(lease_id, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", lease_id):
        log("place_bad_response", status=status, response=body)
        raise LaunchError("scheduler placement response missing gpu or lease_id")
    return Placement(str(gpu), str(lease_id))


