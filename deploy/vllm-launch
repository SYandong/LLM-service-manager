def parse_args(argv: list[str]) -> LaunchArgs:
    if "--" not in argv:
        raise LaunchError("expected -- before the vllm command", 64)
    separator_index = argv.index("--")
    launcher_argv = argv[:separator_index]
    command = argv[separator_index + 1 :]
    if not command:
        raise LaunchError("missing vllm command", 64)
    parser = argparse.ArgumentParser(
        prog="vllm-launch",
        description="Request scheduler placement, start vLLM under systemd, confirm the lease.",
    )
    parser.add_argument("util")
    parser.add_argument("unit")
    parser.add_argument("--config", dest="config_path")
    parser.add_argument("--dry-run", action="store_true")
    ns = parser.parse_args(launcher_argv)
    return LaunchArgs(ns.util, ns.unit, command, ns.config_path, ns.dry_run)


def unit_service_name(unit: str, config: dict[str, Any]) -> str:
    suffix = str(config.get("unit_suffix", ".service"))
    return unit if unit.endswith(suffix) else unit + suffix


def scheduler_model_from_unit(unit: str, config: dict[str, Any]) -> str:
    suffix = str(config.get("unit_suffix", ".service"))
    model = unit[:-len(suffix)] if suffix and unit.endswith(suffix) else unit
    if not re.fullmatch(r"vllm-[A-Za-z0-9][A-Za-z0-9_.-]*", model):
        raise LaunchError("unit must use the vllm-<model> namespace", 64)
    model = model[len("vllm-") :]
    if not model:
        raise LaunchError("could not extract scheduler model id from unit", 64)
    return model


def extract_port(command: list[str]) -> str | None:
    for index, part in enumerate(command):
        if part == "--port" and index + 1 < len(command):
            return command[index + 1]
        if part.startswith("--port="):
            return part.split("=", 1)[1]
    return None


def request_json(
    method: str,
    url: str,
    payload: dict[str, Any] | None,
    timeout: float,
) -> tuple[int, dict[str, Any]]:
    data = None
    headers = {"Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read().decode("utf-8")
            parsed = json.loads(body) if body else {}
            if not isinstance(parsed, dict):
                raise LaunchError(f"non-object JSON response from {url}")
            return response.status, parsed
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(body) if body else {}
        except json.JSONDecodeError:
            parsed = {"error": body}
        if not isinstance(parsed, dict):
            parsed = {"error": body}
        return exc.code, parsed
    except urllib.error.URLError as exc:
        raise LaunchError(f"HTTP request failed for {url}: {exc.reason}") from exc


def scheduler_url(config: dict[str, Any], path: str, dry_run: bool = False) -> str:
    base = str(config["scheduler_url"]).rstrip("/")
    url = base + path
    if dry_run:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}dry_run=1"
    return url


def request_placement(
    config: dict[str, Any],
    model: str,
    util: str,
    dry_run: bool,
) -> Placement | None:
    util_value = float(util)
    if not math.isfinite(util_value) or util_value <= 0:
        raise LaunchError("util must be a positive finite number", 64)
    payload = {"model": model, "util": util_value}
    url = scheduler_url(config, str(config["place_path"]), dry_run=dry_run)
    status, body = request_json(
        "POST",
        url,
        payload,
        float(config["request_timeout_seconds"]),
    )
    if dry_run:
        log("dry_run_place", status=status, response=body)
        if status >= 400:
            raise LaunchError(f"scheduler dry-run placement failed with HTTP {status}", 75)
        return None
    if status == 409:
        log("place_conflict", status=status, response=body)
        raise LaunchError("scheduler rejected placement with 409", 75)
    if status >= 400:
        log("place_failed", status=status, response=body)
        raise LaunchError(f"scheduler placement failed with HTTP {status}", 75)
