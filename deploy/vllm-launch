            if runtime_state != "inactive" or not release_safe(unit_service):
                log("startup_timeout_budget_retained", unit=unit_service, lease_id=placement.lease_id)
                return 1
            status, body = post_lease(config, "release_path_template", placement.lease_id)
            log("startup_timeout_release", unit=unit_service, lease_id=placement.lease_id, status=status, response=body)
