+func TestServer_PeerIP(t *testing.T) {
+	cases := []struct {
+		name  string
+		setup func(*http.Request)
+		want  string
+	}{
+		{"ipv4 host port", func(r *http.Request) { r.RemoteAddr = "10.0.0.7:4321" }, "10.0.0.7"},
+		{"ipv6 host port", func(r *http.Request) { r.RemoteAddr = "[::1]:80" }, "::1"},
+		{"unparseable address", func(r *http.Request) { r.RemoteAddr = "not-a-host-port" }, "not-a-host-port"},
+		{"x-forwarded-for ignored", func(r *http.Request) {
+			r.RemoteAddr = "10.0.0.7:4321"
+			r.Header.Set("X-Forwarded-For", "1.2.3.4")
+		}, "10.0.0.7"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			r := httptest.NewRequest(http.MethodGet, "/", nil)
+			r.RemoteAddr = ""
+			c.setup(r)
+			if got := peerIP(r); got != c.want {
+				t.Errorf("peerIP() = %q, want %q", got, c.want)
+			}
+		})
+	}
