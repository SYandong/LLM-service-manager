+// peerIP returns the socket peer's address for usage attribution. Unlike
+// clientIP, it never consults client-controlled proxy headers.
+func peerIP(r *http.Request) string {
+	if host, _, err := net.SplitHostPort(r.RemoteAddr); err == nil {
+		return host
+	}
+	return r.RemoteAddr
+}
