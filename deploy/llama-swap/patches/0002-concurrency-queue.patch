+	assertAdmitted(t, r1)
+	if got := eff.served("a"); got != 1 {
+		t.Fatalf("served(a)=%d want 1", got)
+	}
+	if got := waitingOrder(s, "a"); len(got) != 2 || got[0] != "a" || got[1] != "a" {
+		t.Fatalf("waiting=%v want two requests for a", got)
