+// TestFIFO_ConcurrencyQueue_ZeroRejectsImmediately verifies that the default
+// concurrencyQueue of 0 keeps the original immediate 429 behaviour.
+func TestFIFO_ConcurrencyQueue_ZeroRejectsImmediately(t *testing.T) {
+	s, eff := newFIFOWithQueue(t, 1, 0)
+
+	r1 := req("a")
+	s.OnRequest(r1)
+	assertAdmitted(t, r1)
+
+	r2 := req("a")
+	s.OnRequest(r2)
+	assertAdmission429(t, r2)
+
+	if got := len(s.waiting["a"]); got != 0 {
+		t.Fatalf("waiting len=%d want 0 (queue disabled)", got)
+	}
+	if got := eff.errored("a"); got != 0 {
+		t.Fatalf("errored(a)=%d want 0 (reject before grant)", got)
+	}
+}
