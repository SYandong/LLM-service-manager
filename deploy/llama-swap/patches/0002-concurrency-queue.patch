+func TestFIFO_ConcurrencyQueue_WaitsAndDrainsFIFO(t *testing.T) {
+	s, eff := newFIFOWithQueue(t, 1, 2)
+
+	r1 := reqCh("a")
+	r2 := reqCh("a")
+	r3 := reqCh("a")
+	s.OnRequest(r1)
+	s.OnRequest(r2)
+	s.OnRequest(r3)
