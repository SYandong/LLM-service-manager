+
+	if got := len(s.waiting["a"]); got != 2 {
+		t.Fatalf("waiting len=%d want 2 after cancel", got)
+	}
+	for _, w := range s.waiting["a"] {
+		if w.Respond == r3.Respond {
+			t.Fatal("cancelled request still present in wait list")
+		}
+	}
+
+	// Drain: r2 then r4 are promoted; r3 never is.
+	s.OnServeDone(ServeDoneEvent{ModelID: "a"})
+	assertAdmitted(t, r2)
+	s.OnServeDone(ServeDoneEvent{ModelID: "a"})
+	assertAdmitted(t, r4)
+	assertNoAdmission(t, r3)
+
+	if got := eff.served("a"); got != 3 {
+		t.Fatalf("served(a)=%d want 3 (r1, r2, r4)", got)
+	}
+}
