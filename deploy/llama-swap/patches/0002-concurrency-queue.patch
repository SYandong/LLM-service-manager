+// TestFIFO_ConcurrencyQueue_OnUnloadFailsWaiters verifies unloading a model
+// fails every request parked in its wait list through the admission channel,
+// without touching their (nonexistent) reservations.
+func TestFIFO_ConcurrencyQueue_OnUnloadFailsWaiters(t *testing.T) {
+	s, eff := newFIFOWithQueue(t, 1, 2)
+
+	r1 := req("a")
+	r2 := reqCh("a")
+	r3 := reqCh("a")
+	s.OnRequest(r1)
+	s.OnRequest(r2)
+	s.OnRequest(r3)
+	assertAdmitted(t, r1)
+
+	s.OnUnload([]string{"a"}, time.Second)
+
+	if got := len(s.waiting["a"]); got != 0 {
+		t.Fatalf("waiting len=%d want 0 after unload", got)
+	}
+	for i, r := range []HandlerReq{r2, r3} {
+		err := admitErr(t, r)
+		if err == nil {
+			t.Fatalf("waiter %d admitted after unload, want error", i)
+		}
+		if got := err.Error(); got != "test: model unloaded" {
+			t.Fatalf("waiter %d err=%q want %q", i, got, "test: model unloaded")
+		}
+	}
+	if got := eff.errored(""); got != 0 {
+		t.Fatalf("error grants=%d want 0 (unload reported via admission)", got)
+	}
+}
