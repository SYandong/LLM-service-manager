+// TestFIFO_ConcurrencyQueue_WaitingPriorityOrder verifies the shared insertion
+// helper orders a list by descending priority while preserving arrival order
+// for ties, and that admit parks same-model requests in arrival (FIFO) order.
+func TestFIFO_ConcurrencyQueue_WaitingPriorityOrder(t *testing.T) {
+	cfg := config.FifoConfig{Priority: map[string]int{"a": 10, "b": 5, "c": 1}}
+	s := NewFIFO("test", logmon.NewWriter(io.Discard), &stubPlanner{}, cfg, nil, newFakeEffects())
+
+	var list []HandlerReq
+	for _, m := range []string{"c", "a", "b", "b"} {
+		list = s.insertByPriority(list, reqCh(m))
+	}
+	var got []string
+	for _, r := range list {
+		got = append(got, r.Model)
+	}
+	want := []string{"a", "b", "b", "c"}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("priority order=%v want %v", got, want)
+		}
+	}
+
+	// Same model: equal priority, so admit preserves arrival order.
+	s2, _ := newFIFOWithQueue(t, 1, 3)
+	s2.OnRequest(req("a")) // served, holds the only slot
+	first := reqCh("a")
+	second := reqCh("a")
+	s2.OnRequest(first)
+	s2.OnRequest(second)
+	if got := s2.waiting["a"]; len(got) != 2 || got[0].Respond != first.Respond || got[1].Respond != second.Respond {
+		t.Fatalf("wait list not in arrival order: %v", got)
+	}
+}
