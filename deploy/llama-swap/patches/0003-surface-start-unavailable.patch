+		"retry bool":      strings.Replace(unavailableMarker, `"retry_after":60`, `"retry_after":true`, 1),
+		"retry string":    strings.Replace(unavailableMarker, `"retry_after":60`, `"retry_after":"60"`, 1),
+		"retry zero":      strings.Replace(unavailableMarker, `"retry_after":60`, `"retry_after":0`, 1),
+		"retry negative":  strings.Replace(unavailableMarker, `"retry_after":60`, `"retry_after":-1`, 1),
+		"retry excessive": strings.Replace(unavailableMarker, `"retry_after":60`, `"retry_after":86401`, 1),
+		"message number":  strings.Replace(unavailableMarker, `"All placement GPUs are occupied"`, "123", 1),
+		"message null":    strings.Replace(unavailableMarker, `"All placement GPUs are occupied"`, "null", 1),
+		"message empty":   strings.Replace(unavailableMarker, "All placement GPUs are occupied", "  ", 1),
+		"unknown field":   strings.TrimSuffix(unavailableMarker, "}") + `,"other":1}`,
+		"case alias":      strings.Replace(unavailableMarker, `"event":`, `"EVENT":`, 1),
