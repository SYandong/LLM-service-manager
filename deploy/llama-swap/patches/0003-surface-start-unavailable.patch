+		"truncated":       unavailableMarker[:len(unavailableMarker)-1],
+		"prefix":          "wrapper: " + unavailableMarker,
+		"trailing":        unavailableMarker + " log text",
+		"two objects":     unavailableMarker + unavailableMarker,
+		"array":           "[" + unavailableMarker + "]",
+		"event":           strings.Replace(unavailableMarker, "llmsvc_unavailable", "other", 1),
+		"code":            strings.Replace(unavailableMarker, "no_feasible_gpu", "placement_timeout", 1),
+		"status string":   strings.Replace(unavailableMarker, `"status":503`, `"status":"503"`, 1),
