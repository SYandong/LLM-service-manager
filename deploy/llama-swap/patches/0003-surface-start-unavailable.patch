+// Generated-By: Codex / gpt-6.1-sol
+package swaputil
+
+import (
+	"fmt"
+	"net/http"
+	"strconv"
+)
+
+// UpstreamUnavailableError preserves the scheduler's temporary GPU capacity
+// refusal across the launcher's stdout/stderr and the process startup error.
+type UpstreamUnavailableError struct {
+	Model      string
+	Message    string
+	RetryAfter int
+}
+
+var _ HTTPError = (*UpstreamUnavailableError)(nil)
+
+func (e *UpstreamUnavailableError) Error() string {
+	return fmt.Sprintf("No GPU available for %s: %s Retry after %ds.", e.Model, e.Message, e.RetryAfter)
+}
+
+func (e *UpstreamUnavailableError) StatusCode() int { return http.StatusServiceUnavailable }
+
+func (e *UpstreamUnavailableError) Header() http.Header {
+	h := http.Header{}
+	h.Set("Content-Type", "application/json")
+	h.Set("Retry-After", strconv.Itoa(e.RetryAfter))
+	return h
+}
+
+func (e *UpstreamUnavailableError) Body() []byte {
+	return NewErrorEnvelope(e.StatusCode(), e.Error(), "no_gpu_available").JSON()
+}
