+// A real child exercises os/exec's stdout/stderr drain before cmdDone closes.
+// The same process object retries through unavailable, ordinary failure and
+// successful startup, proving the marker is scoped to its startup incarnation.
+func TestProcessUnavailableRetryAndDrainedOutput(t *testing.T) {
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	health := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) }))
+	defer health.Close()
+	parent, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	logger := logmon.NewWriter(io.Discard)
+	p, err := New(parent, "test-model", config.ModelConfig{
+		Cmd:   fmt.Sprintf("%q -test.run=^TestUnavailableCommandHelper$", executable),
+		Proxy: health.URL, CheckEndpoint: "/health",
+		Env: []string{"LLMSVC_UNAVAILABLE_HELPER=" + filepath.Join(t.TempDir(), "attempt")},
+	}, logger, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { p.Stop(time.Second) })
+	ctx, end := context.WithTimeout(context.Background(), 10*time.Second)
+	defer end()
+	err = p.EnsureReady(ctx, 5*time.Second)
+	var unavailable *swaputil.UpstreamUnavailableError
+	if !errors.As(err, &unavailable) || unavailable.Model != "test-model" {
+		t.Fatalf("first startup error = %v", err)
+	}
+	err = p.EnsureReady(ctx, 5*time.Second)
+	if err == nil || errors.As(err, &unavailable) || err.Error() != "upstream command exited prematurely" {
+		t.Fatalf("ordinary retry poisoned by old marker: %v", err)
+	}
+	if err = p.EnsureReady(ctx, 5*time.Second); err != nil {
+		t.Fatalf("healthy retry failed: %v", err)
+	}
+	if err = p.Stop(time.Second); err != nil {
+		t.Fatal(err)
+	}
+	err = p.EnsureReady(ctx, 5*time.Second)
+	if err == nil || errors.As(err, &unavailable) || err.Error() != "upstream command exited prematurely" {
+		t.Fatalf("restart after successful startup inherited old marker: %v", err)
+	}
+}
+
+func TestUnavailableCommandHelper(t *testing.T) {
+	path := os.Getenv("LLMSVC_UNAVAILABLE_HELPER")
+	if path == "" {
+		return
+	}
+	data, _ := os.ReadFile(path)
+	attempt, _ := strconv.Atoi(string(data))
+	attempt++
+	if err := os.WriteFile(path, []byte(strconv.Itoa(attempt)), 0600); err != nil {
+		os.Exit(1)
+	}
+	switch attempt {
+	case 1:
+		// Enough ordinary output to span several pipe reads, followed by a
+		// split final marker immediately before exit on the other stream.
+		fmt.Fprintln(os.Stdout, strings.Repeat("x", 100000))
+		fmt.Fprint(os.Stderr, unavailableMarker[:40])
+		fmt.Fprintln(os.Stderr, unavailableMarker[40:])
+		os.Exit(75)
+	case 2, 4:
+		fmt.Fprintln(os.Stderr, "ordinary startup failure")
+		os.Exit(75)
+	default:
+		time.Sleep(30 * time.Second)
+		os.Exit(0)
+	}
+}
