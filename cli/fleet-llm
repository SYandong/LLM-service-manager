            self.reset_cursor()

    def close(self, timeout=None):
        self._stop.set()
        self._wake.set()
        self._interrupt()
        if self.thread is not None:
            wait = self.client.timeout + self.stream_timeout + 1 if timeout is None else positive_timeout(timeout)
            self.thread.join(timeout=wait)
            return not self.thread.is_alive()
        return True

    def _run(self):
        delay = self.retry_delay
        while not self._stop.is_set():
            with self._lock:
                cursor, generation, incarnation = self._cursor, self._generation, self._incarnation
            response = None
            try:
                query = {"since": cursor}
                if incarnation is not None:
                    query["incarnation"] = incarnation
