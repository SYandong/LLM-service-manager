def event_lines(response):
    """Read available bytes without waiting for a full buffer; accept LF/CRLF/CR."""
    line, after_cr = bytearray(), False
    while True:
        chunk = response.read1(4096)
        if not chunk:
            return  # An incomplete line/event at EOF is replayed after reconnect.
        for value in chunk:
            if after_cr:
                after_cr = False
                if value == 10:
                    continue
            if value in (10, 13):
                yield bytes(line)
                line.clear()
                after_cr = value == 13
            else:
                line.append(value)
                if len(line) > 65536:
                    raise ClientError("Fleet observer SSE line exceeds 64 KiB")


def iter_events(response):
    """Decode bounded fleet observer SSE frames; heartbeats never advance the cursor."""
    data, event_id, size = [], None, 0
    first = True
    for raw in event_lines(response):
        size += len(raw) + 1
        if size > 262144:
            raise ClientError("Fleet observer SSE frame exceeds 256 KiB")
        try:
            line = raw.decode("utf-8")
        except UnicodeError:
            raise ClientError("Fleet observer SSE contains invalid UTF-8") from None
        if first:
            line = line.removeprefix("\ufeff")
            first = False
        if not line:
            if data:
                try:
                    item = json.loads("\n".join(data), parse_constant=invalid_constant)
                    valid = (
                        event_id is not None and isinstance(item, dict)
                        and type(item.get("id")) is int and item["id"] == event_id
                        and isinstance(item.get("kind"), str)
                        and type(item.get("timestamp")) in (int, float)
                        and math.isfinite(item["timestamp"])
                    )
                except (ValueError, OverflowError):
                    valid = False
                if not valid:
                    raise ClientError("Fleet observer SSE contains an invalid event record")
                yield item
            data, event_id, size = [], None, 0
            continue
        if line.startswith(":"):
            continue
        field, _, value = line.partition(":")
        value = value.removeprefix(" ")
        if field == "data":
            data.append(value)
        elif field == "id":
            if not value.isascii() or not value.isdigit():
                raise ClientError("Fleet observer SSE contains an invalid event ID")
            try:
                event_id = int(value)
            except ValueError:
                raise ClientError("Fleet observer SSE contains an invalid event ID") from None


class EventReader:
    """One background subscription to fleet observer SSE with a bounded delivery queue."""

    def __init__(self, client, *, stream_timeout=30, retry_delay=1, max_retry_delay=30, queue_size=256):
