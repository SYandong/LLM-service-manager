        active = window.get("active_minutes")
        add("    24h %s  active %s(%s)" % (
            fleet_activity_bar(item["hourly_active_24h"]), fleet_age(None if active is None else active * 60),
            "—" if ratio is None else "%s%%" % number(ratio * 100)))
        add("    input %s · output %s · total %s" % (
            fleet_tokens(window.get("prompt_tokens")), fleet_tokens(window.get("gen_tokens")),
            fleet_tokens(fleet_total_tokens(window))))
        add("    idle %s · uptime %s · id %s" % (
            "—" if status == "unknown" else fleet_age(item.get("idle_seconds")),
            fleet_age(item.get("uptime_seconds")), fleet_display_text(
                item["id"], [item], show_names, preserve_models=False)))
        coverage = window.get("coverage_ratio")
        if coverage is not None and coverage < 1:
            observed = window.get("observed_active_ratio")
            add("    observed coverage %s%% (24h)%s" % (number(coverage * 100),
                " · observed active %s%%" % number(observed * 100) if observed is not None else ""))

    if by == "gpu":
        observed = {item["index"]: item for item in result.get("gpus", [])}
        indexes = set(observed) | {index for item in services for index in item["gpus"]}
        for index in sorted(indexes):
            gpu = observed.get(index, {"index": index})
            add("GPU%s · %s/%sG · utilization %s%%" % (
                gpu["index"], number(gpu.get("used_gb")), number(gpu.get("total_gb")), number(gpu.get("util_percent"))))
            for occupant in gpu.get("occupants", []):
                if not occupant.get("service_id"):
                    add("  %s (%s) %sG" % (owner(occupant),
                        "Work" if occupant.get("kind") in (None, "other") else occupant["kind"], number(occupant.get("used_gb"))))
            for item in sorted((item for item in services if gpu["index"] in item["gpus"]), key=order):
                add("  owner " + owner(item))
                amounts = [occupant.get("used_gb") for occupant in gpu.get("occupants", [])
                           if occupant.get("service_id") == item["id"]]
                memory = sum(amounts) if amounts and all(value is not None for value in amounts) else None
                service(item, gpu=gpu["index"], memory=memory)
        for item in sorted((item for item in services if not item["gpus"]), key=order):
            add("No observed GPU · " + owner(item))
            service(item)
    else:
        groups = {}
        for item in services:
            groups.setdefault(fleet_owner(item)[0], []).append(item)
        for identity in sorted(groups, key=lambda identity: (owner(groups[identity][0]), identity)):
            items = groups[identity]
            label = owner(items[0])
            memory = None if any(item.get("gpu_gb") is None for item in items) else sum(item["gpu_gb"] for item in items)
            over = sum(item["status"] == "over_limit" for item in items) if not result.get("stale") else 0
            add("%s · %s services · %sG%s" % (label, len(items), number(memory), " · %s running inactive" % over if over else ""))
            for item in sorted(items, key=order):
                service(item)
    if not services:
        add("No inference services observed")
    return "\n".join(lines)


def validate_fleet_history(args, result):
    if not isinstance(result, dict):
        raise ClientError("Invalid fleet history response; check the server API version")
    valid = (
        type(result.get("schema_version")) is int and result["schema_version"] == 1
        and result.get("service_id") == args.service and result.get("hours") == args.hours
        and result.get("resolution") == ("hourly" if args.hours == 168 else "minute")
        and isinstance(result.get("samples"), list) and isinstance(result.get("service", {}), dict)
    )
    for item in result.get("samples", []) if valid else []:
        timestamp = item.get("ts", item.get("hour_ts")) if isinstance(item, dict) else None
        valid = type(timestamp) in (int, float) and math.isfinite(timestamp) and timestamp >= 0
        active = item.get("active") if isinstance(item, dict) else None
        valid = valid and (active is None or (type(active) in (bool, int) and active in (0, 1)))
        if not valid:
            break
        for key in ("running", "waiting", "d_requests", "d_gen_tokens", "d_prompt_tokens", "active_minutes", "requests", "gen_tokens", "prompt_tokens"):
            value = item.get(key)
            if value is not None and not (type(value) in (int, float) and math.isfinite(value) and value >= 0):
                valid = False
                break
        if not valid:
            break
    if not valid:
        raise ClientError("Invalid fleet history response; check the server API version")
    return result


def format_fleet_history(result, width=100, *, show_names=False):
    service = result.get("service", {})
    lines = ["Fleet history · %s · last %sh · %s (UTC)" % (
        fleet_display_text(result["service_id"], [service], show_names, preserve_models=False),
        result["hours"], result["resolution"])]
    if service.get("model") or service.get("host") is True or service.get("container"):
        lines.append("%s · %s · %s" % (fleet_model_label(service.get("model")),
                     service.get("engine", "—"), fleet_owner(service, show_names)[1]))
    if service.get("argv_redacted"):
        lines.append("Parameters: " + fleet_display_text(service["argv_redacted"], [service], show_names))
    hourly = result["resolution"] == "hourly"
    lines.append("UTC time             Active   Requests  Output  Input" if hourly else
                 "UTC time             Active   Running  Waiting  Requests  Output  Input")
    for item in result["samples"]:
        timestamp = item.get("ts", item.get("hour_ts"))
        stamp = datetime.fromtimestamp(timestamp, timezone.utc).strftime("%m-%d %H:%MZ")
        if hourly:
            active = "—" if item.get("active_minutes") is None else number(item["active_minutes"]) + "m"
            values = [active] + [fleet_number(item.get(key)) for key in ("requests", "gen_tokens", "prompt_tokens")]
        else:
            active = "—" if item.get("active") is None else "yes" if item["active"] else "no"
            values = [active] + [fleet_number(item.get(key)) for key in ("running", "waiting", "d_requests", "d_gen_tokens", "d_prompt_tokens")]
        lines.append(stamp + "  " + "  ".join(values))
    if not result["samples"]:
        lines.append("No recorded samples in this window")
    return "\n".join(part for line in lines for part in wrap_line(line, max(1, width)))


def service_id(value):
    if not value.strip() or any(unicodedata.category(ch).startswith("C") for ch in value):
        raise argparse.ArgumentTypeError("Service ID must be nonempty and contain no control characters")
    return value


def build_parser(parser_class=argparse.ArgumentParser):
    parser = parser_class(prog="llm", description="Inspect observed GPU services and activity")
    parser.add_argument("--version", action="version", version="1.10.0")
    parser.add_argument("--url", help="Fleet observer URL (overrides LLM_URL and config)")
    parser.add_argument("--config", help="Config file (default: ~/.config/llm/config)")
    parser.add_argument("--timeout", help="HTTP timeout in seconds")
    parser.add_argument("--show-names", action="store_true", help="Reveal anonymous owner names")
    commands = parser.add_subparsers(dest="command")
    for command in ("status", "fleet"):
        fleet = commands.add_parser(command, help="Show observed inference services")
        fleet.add_argument("--by", choices=("person", "gpu"), default="person")
        fleet.add_argument("--sort", choices=("idle", "mem", "tokens"),
                           help="Sort descending (default: inactive, then memory)")
        fleet.add_argument("--mine", action="store_true", help="Filter by the real socket peer's container")
        fleet.add_argument("--json", action="store_true", help="Print the complete JSON snapshot")
        fleet.add_argument("--plain", action="store_true", help="Print text without terminal colors")
        fleet.add_argument("--show-names", action="store_true", default=argparse.SUPPRESS)
    top = commands.add_parser("top", help="Open the optional fleet TUI (text fallback outside a terminal)")
    top.add_argument("--show-names", action="store_true", default=argparse.SUPPRESS)
    history = commands.add_parser("history", help="Read a service's recorded activity")
    history.add_argument("service", type=service_id)
    history.add_argument("--hours", type=int, choices=(24, 168), default=24)
    history.add_argument("--json", action="store_true")
    history.add_argument("--show-names", action="store_true", default=argparse.SUPPRESS)
    return parser


def app_version(parser_class=argparse.ArgumentParser):
    return next(str(action.version) for action in build_parser(parser_class)._actions
                if action.dest == "version")


def execute_command(args, client):
    if args.command in (None, "top", "fleet", "status"):
        result = validate_fleet(client.request("GET", "/v1/fleet" +
                                ("?mine=1" if getattr(args, "mine", False) else "")))
        args._fleet_display_items = fleet_display_items(result)
        return result
    if args.command == "history":
        path = "/v1/fleet/history?" + urlencode({"service": args.service, "hours": args.hours})
        result = validate_fleet_history(args, client.request("GET", path))
        args._fleet_display_items = [result.get("service", {})]
        return result
    raise ClientError("Unsupported fleet read command")


def format_result(args, result, width=100, *, color=False):
    if getattr(args, "json", False):
        return json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False)
    if args.command == "history":
        return format_fleet_history(result, width=width, show_names=args.show_names)
    return format_fleet(result, width=width, by=getattr(args, "by", "person"),
                        sort=getattr(args, "sort", None),
                        color=color and not getattr(args, "plain", False), show_names=args.show_names)


def fleet_tui_app():
    try:
        return importlib.import_module("tui.fleet_app").FleetApp
    except ImportError:
        return None


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        client = FleetClient(**load_config(path=args.config, url=args.url, timeout=args.timeout))
        if args.command in (None, "top") and sys.stdout.isatty():
            app = fleet_tui_app()
            if app is not None:
                app(client=client, api=SimpleNamespace(**globals()), show_names=args.show_names).run()
                return 0
        result = execute_command(args, client)
        print(format_result(args, result, width=shutil.get_terminal_size((100, 30)).columns,
                            color=sys.stdout.isatty() and "NO_COLOR" not in os.environ))
        if args.command in (None, "top"):
            print("TUI: install with pip install 'llmsvc[tui]' and run llm in a terminal.")
        return 0
    except ClientError as exc:
        message = fleet_display_text(exc, getattr(args, "_fleet_display_items", ()), args.show_names)
        if exc.status is not None and not args.show_names:
            code = exc.payload.get("error") if isinstance(exc.payload, dict) else None
            code = code if isinstance(code, str) and code in FLEET_ERROR_CODES else "Fleet request failed"
            message = "HTTP %s: %s" % (exc.status, code)
        print("llm: " + message, file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError, OverflowError):
        print("llm: Invalid fleet response; check the server API version", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
