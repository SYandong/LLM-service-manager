            parts = ["\033[%sm%s\033[0m" % (colors[status], part) for part in parts]
        lines.extend(parts)

    add("GPU inference services · snapshot %s ago · idle limit %sh" % (
        fleet_age(result.get("snapshot_age_seconds")), number(result.get("config", {}).get("idle_limit_hours"))))
    if result.get("stale"):
        add("WARNING stale fleet snapshot; activity is unknown")
    for error in result.get("errors", []):
        add("WARNING " + fleet_display_text(error, fleet_display_items(result), show_names))
