def cell_width(text):
    return sum(0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def number(value):
    return "?" if value is None else format(value, ".1f").rstrip("0").rstrip(".")


def wrap_line(line, width):
    """Wrap even long identifiers without exceeding terminal display cells."""
    lines, current = [], ""
    for ch in clean_text(line):
        if cell_width(ch) > width:
            ch = "?"
        if current and cell_width(current + ch) > width:
            lines.append(current.rstrip())
            current = ""
        current += ch
    lines.append(current.rstrip())
    return lines


def fleet_number(value):
    if value is None:
        return "—"
    for scale, suffix in ((1000000000, "b"), (1000000, "m"), (1000, "k")):
        if value >= scale:
            return number(value / scale) + suffix
    return number(value)


def fleet_tokens(value):
    return (format(int(value), ",") if value is not None else "—") + " tokens"


def fleet_total_tokens(window):
    prompt, generated = window.get("prompt_tokens"), window.get("gen_tokens")
    if prompt is None or generated is None:
        return None
    total = prompt + generated
    return total if math.isfinite(total) else None


def fleet_age(seconds):
    if seconds is None:
        return "—"
    minutes = int(max(0, seconds) // 60)
    if minutes >= 1440:
        return number(seconds / 86400) + "d"
    if minutes >= 60:
        return "%dh%02dm" % divmod(minutes, 60)
    return "%dm" % minutes if minutes else "%ds" % int(max(0, seconds))


def fleet_activity_bar(values):
    """One cell per hour; missing activity is visible rather than zero-filled."""
    return "".join("·" if value is None else "▁▂▃▄▅▆▇█"[min(7, int(value * 7 / 60))]
                   for value in values)


def validate_fleet(result):
    if not isinstance(result, dict):
        raise ClientError("Invalid fleet response; check the server API version")
    def amount(value):
        return value is None or (type(value) in (int, float) and math.isfinite(value) and value >= 0)

    def host_fields(item):
        return ((item.get("host") is None or type(item["host"]) is bool)
                and (item.get("host_uid") is None or (type(item["host_uid"]) is int and item["host_uid"] >= 0))
                and (item.get("host_user") is None or isinstance(item["host_user"], str)))

    def api_address(value):
        if value is None:
            return True
        if not isinstance(value, str) or len(value) > 512 or any(c.isspace() or ord(c) < 32 for c in value):
            return False
        try:
            parsed = urlsplit(value)
            return (parsed.scheme == "http" and parsed.username is None and parsed.password is None
                    and parsed.path in ("", "/") and not parsed.query and not parsed.fragment
                    and parsed.port is not None and 1 <= parsed.port <= 65535
                    and "%" not in parsed.hostname and bool(ipaddress.ip_address(parsed.hostname)))
        except (ValueError, TypeError):
            return False

    valid = (
        type(result.get("schema_version")) is int and result["schema_version"] == 1
        and isinstance(result.get("services"), list) and isinstance(result.get("gpus"), list)
        and type(result.get("stale")) is bool and amount(result.get("generated_at"))
        and amount(result.get("snapshot_age_seconds")) and isinstance(result.get("config"), dict)
        and amount(result["config"].get("idle_limit_hours"))
        and isinstance(result.get("errors", []), list)
    )
    ids = set()
    for item in result.get("services", []) if valid else []:
        valid = (
            isinstance(item, dict)
            and all(isinstance(item.get(key), str) and item[key] for key in ("id", "engine"))
            and (isinstance(item.get("model"), str) or item.get("model") is None)
            and ((isinstance(item.get("container"), str) and bool(item["container"]))
                 or (item.get("container") is None and item.get("host") is True))
            and host_fields(item)
            and item["id"] not in ids
            and item.get("status") in ("active", "idle", "over_limit", "unknown")
            and isinstance(item.get("gpus"), list)
            and all(type(gpu) is int and gpu >= 0 for gpu in item["gpus"])
            and all(amount(item.get(key)) for key in ("gpu_gb", "idle_seconds", "uptime_seconds"))
            and isinstance(item.get("window_24h", {}), dict)
            and isinstance(item.get("hourly_active_24h"), list) and len(item["hourly_active_24h"]) == 24
            and all(amount(value) and (value is None or value <= 60) for value in item["hourly_active_24h"])
            and (item.get("claim") is None or isinstance(item["claim"], dict))
            and ("api_address" not in item or api_address(item["api_address"]))
            and ("api_access" not in item or item["api_access"] in ("shared", "local_only", "direct", "unknown"))
            and ("idle_time_sensitive" not in item or type(item["idle_time_sensitive"]) is bool)
        )
        if not valid:
            break
        window = item.get("window_24h", {})
        valid = all(amount(window.get(key)) for key in (
            "active_minutes", "active_ratio", "observed_active_ratio", "gen_tokens", "prompt_tokens", "requests", "coverage_ratio"))
        if not valid:
            break
        ids.add(item["id"])
    for gpu in result.get("gpus", []) if valid else []:
        valid = (
            isinstance(gpu, dict) and type(gpu.get("index")) is int and gpu["index"] >= 0
            and all(amount(gpu.get(key)) for key in ("used_gb", "total_gb", "util_percent"))
            and isinstance(gpu.get("occupants", []), list)
            and all(isinstance(item, dict) and amount(item.get("used_gb")) and host_fields(item)
                    for item in gpu.get("occupants", []))
        )
        if not valid:
            break
    if not valid:
        raise ClientError("Invalid fleet response; check the server API version")
    return result


def fleet_owner(item, show_names=False):
    """Keep canonical owner keys separate from their optional visible names."""
    container = item.get("container")
    if isinstance(container, str) and container:
        identity, name = "container:" + container, clean_text(container)
    elif item.get("host") is True:
        uid = item.get("host_uid")
        if type(uid) is not int or uid < 0:
            return "host", "Unknown"
        user = item.get("host_user")
        user = clean_text(user).strip() if isinstance(user, str) else ""
        identity, name = "host:uid:" + str(uid), user or "UID " + str(uid)
    else:
        return "unknown", "Unknown"
    if not show_names:
        digest = hashlib.sha256(identity.encode("utf-8")).digest()
        name = "User %09d" % (int.from_bytes(digest, "big") % 1000000000)
    return identity, name


def fleet_model_label(value):
    """Shorten absolute model filesystem paths, preserving repository IDs."""
    value = str(value or "unknown")
    return value.rstrip("/").rsplit("/", 1)[-1] if value.startswith("/") and value.strip("/") else value


def fleet_display_text(value, items=(), show_names=False, *, preserve_models=True):
    """Apply the same presentation rules to IDs, parameters and diagnostics."""
    text, names, models = clean_text(value), {}, set()
    for item in items:
        model = item.get("model")
        if isinstance(model, str) and model.startswith("/"):
            text = text.replace(model, fleet_model_label(model))
        if preserve_models and isinstance(model, str) and model:
            models.add(fleet_model_label(model))
        if show_names:
            continue
        identity, label = fleet_owner(item)
        if identity in ("host", "unknown"):
            continue
        names.setdefault(identity, label)
        raw_name = item.get("container") if identity.startswith("container:") else item.get("host_user")
        if isinstance(raw_name, str) and raw_name:
            names.setdefault(raw_name, label)
    if names:
        keep = r"User [0-9]{9}(?!\d)"
        if models:
            keep += r"|(?<![\w./-])(?:" + "|".join(
                re.escape(model) for model in sorted(models, key=len, reverse=True)) + r")(?![\w./:-])"
        pattern = r"(?P<keep>" + keep + r")|(?<![\w.-])(?:" + "|".join(
            re.escape(name) for name in sorted(names, key=len, reverse=True)) + r")(?![\w.-])"
        text = re.sub(pattern, lambda match: match.group() if match.group("keep") else names[match.group()], text)
    return text


def fleet_display_items(result):
    return (list(result.get("services", [])) + list(result.get("containers", [])) +
            [item for gpu in result.get("gpus", []) for item in gpu.get("occupants", [])])


