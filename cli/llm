            raise ValueError
        if nullable:
            return all(key in value and value[key] is None for key in USAGE_COUNT_KEYS)
        return all(type(value.get(key)) is int and value[key] >= 0 for key in USAGE_COUNT_KEYS)

    try:
        valid = (type(result.get("known")) is bool and type(result.get("days")) is int
                 and result["days"] >= 1 and result.get("by") in USAGE_BY_VALUES
                 and isinstance(result.get("rows"), (list, tuple))
                 and isinstance(result.get("totals"), dict))
        if not valid or (days is not None and result["days"] != days) or (by is not None and result["by"] != by):
            raise ValueError
        grouping, other = result["by"], USAGE_OTHER[result["by"]]
        totals = result["totals"]
        if not result["known"]:
            if result["rows"] or not counts_valid(totals, nullable=True):
                raise ValueError
            return result
        if not isinstance(result.get("timezone"), str) or not isinstance(result.get("attribution"), dict):
            raise ValueError
        for counts in [totals, *result["rows"]]:
            counts_valid(counts)
        for row in result["rows"]:
            if not isinstance(row.get(grouping), str) or not isinstance(row.get("kind"), str):
                raise ValueError
            breakdown = row.get("breakdown")
            if not isinstance(breakdown, (list, tuple)):
                raise ValueError
            for item in breakdown:
                counts_valid(item)
                if not isinstance(item.get(other), str) or not isinstance(item.get("kind"), str):
                    raise ValueError
            if any(sum(item[key] for item in breakdown) != row[key] for key in USAGE_COUNT_KEYS):
                raise ValueError
        if any(sum(row[key] for row in result["rows"]) != totals[key] for key in USAGE_COUNT_KEYS):
            raise ValueError
    except (AttributeError, KeyError, TypeError, ValueError):
        raise ClientError("Invalid usage response: counts, grouping or totals are inconsistent") from None
    return result


def usage_number(value):
    return "?" if value is None else "{:,}".format(value)


def usage_duration(duration_ms, requests):
    if not requests or duration_ms is None:
        return "—"
    average = duration_ms / requests
    if average < 1000:
        return "%dms" % int(round(average))
    if average < 60000:
        return "%.1fs" % (average / 1000)
    minutes = int(average // 60000)
    seconds = int(round((average - minutes * 60000) / 1000))
    if seconds >= 60:
        minutes, seconds = minutes + 1, seconds - 60
    return "%dm %02ds" % (minutes, seconds)


def usage_age(last_seen, until):
    if last_seen is None:
        return "—"
    delta = max(0, until - last_seen)
    if delta < 60:
        return "just now"
    if delta < 3600:
        return "%dm ago" % (delta // 60)
    if delta < 86400:
        return "%dh ago" % (delta // 3600)
    return "%dd ago" % (delta // 86400)


def usage_truncate(text, width):
    if width <= 0:
        return ""
    if cell_width(text) <= width:
        return text
    result = ""
    for ch in text:
        if cell_width(result + ch) > width - 1:
            break
        result += ch
    return result + "…"


def usage_zone(name):
    if ZoneInfo is not None and isinstance(name, str) and name:
        try:
            return name, ZoneInfo(name)
        except Exception:
            pass
    return "UTC", timezone.utc


def usage_time(timestamp, zone):
    if timestamp is None:
        return "?"
    try:
        return datetime.fromtimestamp(timestamp, zone).strftime("%Y-%m-%d %H:%M")
    except (ValueError, OverflowError, OSError):
        return "?"


def usage_totals_line(totals):
    parts = ["%s %s" % (usage_number(totals["requests"]),
                        "request" if totals["requests"] == 1 else "requests"),
             "%s input" % usage_number(totals["input_tokens"]),
             "%s output" % usage_number(totals["output_tokens"]),
             "%s tokens" % usage_number(totals["total_tokens"])]
    if totals["errors"]:
        parts.append("%s %s" % (usage_number(totals["errors"]),
                                "error" if totals["errors"] == 1 else "errors"))
    if totals["untracked_requests"]:
        count = totals["untracked_requests"]
        parts.append("%s without token %s" % (
            usage_number(count), "count" if count == 1 else "counts"))
    return " · ".join(parts)


def usage_models_cell(row, other):
    if row["requests"] <= 0:
        return ""
    parts = []
    for item in row["breakdown"]:
        percent = int(round(item["requests"] * 100 / row["requests"]))
        parts.append("%s %d%%" % (clean_text(item[other]), percent))
    return " · ".join(parts)


def usage_row_columns(result, row):
    """The settled numeric cells for one row, a breakdown item or the totals."""
    until = result.get("until") or 0
    return {
        "requests": usage_number(row["requests"]),
        "errors": usage_number(row["errors"]),
        "input_tokens": usage_number(row["input_tokens"]),
        "output_tokens": usage_number(row["output_tokens"]),
        "total_tokens": usage_number(row["total_tokens"]),
        "avg": usage_duration(row["duration_ms"], row["requests"]),
        "last": usage_age(row.get("last_seen"), until),
    }


def usage_column_widths(result):
    rows = list(result["rows"]) + [result["totals"]]
    widths = {}
    for key, label in USAGE_NUMERIC_COLUMNS:
        if key == "last" and result["by"] == "day":
            continue
        values = [usage_row_columns(result, row)[key] for row in rows]
        widths[key] = max(len(label), *(len(value) for value in values))
    return widths


def usage_table(result, width, breakdown):
    by, other = result["by"], USAGE_OTHER[result["by"]]
    rows, totals = result["rows"], result["totals"]
    labels = [cell_width(clean_text(row[by])) for row in rows] or [0]
    if breakdown:
        labels += [cell_width("  └ " + clean_text(item[other]))
                   for row in rows for item in row["breakdown"]]
    label_width = min(24, max(4, max(labels)))
    widths = usage_column_widths(result)
    models_header = "USERS" if by == "model" else "MODELS"
    active = {key for key, _ in USAGE_NUMERIC_COLUMNS}
    if by == "day":
        active.discard("last")
    include_models = True

    def used_width():
        return label_width + sum(2 + widths[key] for key, _ in USAGE_NUMERIC_COLUMNS if key in active)

    while True:
        fits = used_width() <= width and (not include_models or width - used_width() - 2 >= 12)
        if fits:
            break
        if "avg" in active:
            active.discard("avg")
        elif "last" in active:
            active.discard("last")
        elif include_models:
            include_models = False
        elif "errors" in active:
            active.discard("errors")
        else:
            break
    models_width = width - used_width() - 2 if include_models else 0

    def numeric_cells(row, *, skip_extra=False, blank_last=False):
        cells = []
        for key, _ in USAGE_NUMERIC_COLUMNS:
            if key not in active:
                continue
            if skip_extra and key in ("avg", "last"):
                cells.append(" " * widths[key])
            elif blank_last and key == "last":
                cells.append(" " * widths[key])
            else:
                cells.append(usage_row_columns(result, row)[key].rjust(widths[key]))
        return cells

    def render(label, row, *, skip_extra=False, model_cell=None, blank_last=False):
        cells = [fit(label, label_width), *numeric_cells(row, skip_extra=skip_extra, blank_last=blank_last)]
        if include_models and not skip_extra:
            cells.append(usage_truncate(model_cell or "", models_width))
        return "  ".join(cells).rstrip()

    lines = []
    header_cells = [fit(by.upper(), label_width)]
    for key, label in USAGE_NUMERIC_COLUMNS:
        if key in active:
            header_cells.append(label.rjust(widths[key]))
    if include_models:
        header_cells.append(models_header)
    lines.append("  ".join(header_cells).rstrip())
    for row in rows:
        lines.append(render(row[by], row, model_cell=usage_models_cell(row, other)))
        if breakdown:
            for item in row["breakdown"]:
                lines.append(render("  └ " + item[other], item, skip_extra=True))
    lines.append(render("TOTAL", totals, blank_last=True))
    if not rows:
        lines.append("No requests in this window (source available)")
    return lines


def usage_stacked(result, breakdown):
    by, other = result["by"], USAGE_OTHER[result["by"]]
    totals = result["totals"]
    lines = []
    for row in result["rows"]:
        lines.append("%s (%s)" % (clean_text(row[by]), clean_text(row["kind"])))
        lines.append("  Requests: %s" % usage_number(row["requests"]))
        lines.append("  Tokens: %s in / %s out / %s total" % (
            usage_number(row["input_tokens"]), usage_number(row["output_tokens"]),
            usage_number(row["total_tokens"])))
        lines.append("  Errors: %s" % usage_number(row["errors"]))
        if breakdown:
            for item in row["breakdown"]:
                lines.append("  └ %s: %s requests · %s total tokens" % (
                    clean_text(item[other]), usage_number(item["requests"]),
                    usage_number(item["total_tokens"])))
    if not result["rows"]:
        lines.append("No requests in this window (source available)")
    lines.extend(["TOTAL",
                  "  Requests: %s" % usage_number(totals["requests"]),
                  "  Tokens: %s in / %s out / %s total" % (
                      usage_number(totals["input_tokens"]), usage_number(totals["output_tokens"]),
                      usage_number(totals["total_tokens"])),
                  "  Errors: %s" % usage_number(totals["errors"])])
    return lines


def usage_footnotes(result):
    if not result["known"]:
        return []
    lines = []
    kinds = {row["kind"] for row in result["rows"]}
    legend = []
    if "host" in kinds:
        legend.append("host = requests from the host machine")
    if "unattributed" in kinds:
        legend.append("unattributed = recorded before source tracking (no client IP)")
    if "ip" in kinds:
        legend.append("ip:<addr> = client address without a container mapping")
    if legend:
        lines.append("; ".join(legend))
    untracked = result["totals"]["untracked_requests"]
    if untracked:
        lines.append("%s %s no token %s (streaming without stream_options.include_usage); "
                     "their tokens are not in the totals" % (
                         usage_number(untracked),
                         "request has" if untracked == 1 else "requests have",
                         "count" if untracked == 1 else "counts"))
    attribution = result.get("attribution") or {}
    if attribution.get("map_source") == "none" and "ip" in kinds:
        lines.append("Attribution map: none (all sources shown as ip:…)")
    return lines


def format_usage(result, width=100, breakdown=False):
    validate_usage(result)
    width = max(1, width)
    by = result["by"]
    window = "day" if result["days"] == 1 else "days"
    if not result["known"]:
        prose = ["Usage: last %s %s by %s" % (result["days"], window, by),
                 "Unavailable: " + clean_text(result.get("error") or "source unavailable"),
                 "Requests ?  Tokens ?"]
        return "\n".join(part for line in prose for part in wrap_prose(line, width))
    zone_name, zone = usage_zone(result.get("timezone"))
    prose = ["Usage · last %s %s · %s → %s (%s)" % (
        result["days"], window, usage_time(result.get("since"), zone),
        usage_time(result.get("until"), zone), zone_name),
        usage_totals_line(result["totals"])]
    if width < 60:
        body = usage_stacked(result, breakdown)
    else:
        body = usage_table(result, width, breakdown)
    output = [part for line in prose for part in wrap_prose(line, width)]
    output += [part for line in body for part in wrap_line(line, width)]
    output += [part for line in usage_footnotes(result) for part in wrap_prose(line, width)]
    return "\n".join(output)


PIN_COMPATIBILITY_LABEL = "llm-client"


def memory_amount(value):
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)(?:G|GiB)?", value)
    if match is None or not math.isfinite(float(match[1])):
        raise argparse.ArgumentTypeError("Memory must be nonnegative GiB, for example 80G")
    return float(match[1])


def gpu_index(value):
    if not re.fullmatch(r"[0-9]+", value):
        raise argparse.ArgumentTypeError("GPU must be a nonnegative integer")
    return int(value)


def usage_days(value):
    if not re.fullmatch(r"[0-9]+", value):
        raise argparse.ArgumentTypeError("Days must be an integer between 1 and 365")
    days = int(value)
    if not 1 <= days <= 365:
        raise argparse.ArgumentTypeError("Days must be an integer between 1 and 365")
    return days


def action_timeout(value):
    try:
        return positive_timeout(value)
    except ClientError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from None


def reserve_size(value):
    amount = memory_amount(value)
    if amount <= 0:
        raise argparse.ArgumentTypeError("Reservation size must be positive GiB")
    return amount


def intent_expiry(duration, now=None):
    now = time.time() if now is None else now
    until = now + duration
    try:
        if not math.isfinite(until) or until <= now:
            raise ValueError
        datetime.fromtimestamp(until, timezone.utc)
    except (ValueError, OverflowError, OSError):
        raise ClientError("Intent expiry is outside the supported future UTC range") from None
    return until


def validate_reserve_result(args, result):
    def record(item, preview=False):
        if type(item["gpu"]) is not int or item["gpu"] != args.gpu:
            raise ValueError
        if type(item["size_gb"]) not in (int, float) or item["size_gb"] != args.size:
            raise ValueError
        if type(item["until"]) not in (int, float) or not math.isfinite(item["until"]) or item["until"] <= 0:
            raise ValueError
        datetime.fromtimestamp(item["until"], timezone.utc)
        if not isinstance(item["by"], str) or not item["by"].strip():
            raise ValueError
        if preview:
            if "id" in item:
                raise ValueError
        elif not isinstance(item["id"], str) or not item["id"].strip():
            raise ValueError

    try:
        if args.dry_run:
            if not isinstance(result["would"], list) or not isinstance(result["blocked_by"], list):
                raise ValueError
            for item in result["would"]:
                if item["kind"] == "reserve":
                    record(item, preview=True)
                elif item["kind"] != "stop" or not isinstance(item["model"], str):
                    raise ValueError
            blockers = result["blocked_by"]
        else:
            # A historical write receipt can already have expired or been deleted.
            record(result)
            outcome = result["evacuation"]
            if outcome["status"] not in ("complete", "blocked", "partial"):
                raise ValueError
            if not isinstance(outcome["stopped"], list) or not all(isinstance(m, str) for m in outcome["stopped"]):
                raise ValueError
            if "error" in outcome and not isinstance(outcome["error"], str):
                raise ValueError
            blockers = outcome["skipped"]
        if not isinstance(blockers, list) or not all(isinstance(b["reason"], str) for b in blockers):
            raise ValueError
    except (KeyError, TypeError, ValueError, OverflowError, OSError):
        raise ClientError("Invalid reserve response; the intent may have persisted. Check status before retrying") from None
    return result


def format_reserve_result(args, result):
    if args.dry_run:
        return format_action_result(args, result) + "\nPreview owner labels are hypothetical; no reservation ID allocated"
    outcome = result["evacuation"]
    lines = ["Reservation saved (write receipt): %s; owner %s" % (result["id"], result["by"]),
             "GPU%s; requested %s GiB; until %s" % (result["gpu"], result["size_gb"],
                 datetime.fromtimestamp(result["until"], timezone.utc).isoformat()),
             "Evacuation status: " + outcome["status"],
             "Confirmed stopped: " + (", ".join(outcome["stopped"]) or "none")]
    lines += ["Skipped: " + json.dumps(item, ensure_ascii=False, sort_keys=True) for item in outcome["skipped"]]
    if outcome.get("error"):
        lines.append("Error: " + outcome["error"])
    lines.append("Blocked/partial evacuation does not roll back the saved intent; check status for current expiry/deletion")
    lines.append("An active reservation excludes the whole GPU from placement; size is an annotation, not measured free capacity")
    lines.append("Complete does not imply zero GPU use or absence of external processes")
    return "\n".join(clean_text(line) for line in lines)


def validate_action_result(args, result):
    def finite(value, nullable=False):
        return (nullable and value is None) or (type(value) in (int, float) and math.isfinite(value) and value >= 0)

    try:
        if args.dry_run:
            if not isinstance(result["would"], list) or not isinstance(result["blocked_by"], list):
                raise ValueError
            for item in result["would"]:
                if not isinstance(item["kind"], str) or not isinstance(item["model"], str):
                    raise ValueError
            for item in result["blocked_by"]:
                if not isinstance(item["reason"], str):
                    raise ValueError
            if "estimated_freed_gb" in result and not finite(result["estimated_freed_gb"]):
                raise ValueError
        elif args.command == "free":
            if result["status"] not in ("complete", "blocked", "partial", "failed", "timeout", "no_progress"):
                raise ValueError
            for key in ("slept", "stopped"):
                if not isinstance(result[key], list) or not all(isinstance(item, str) for item in result[key]):
                    raise ValueError
            if not isinstance(result["skipped"], list):
                raise ValueError
            for item in result["skipped"]:
                if not isinstance(item["reason"], str):
                    raise ValueError
            expected = "net_host_available_gib" if args.ram else "net_gpu_free_gib"
            if result["measurement"] != expected or type(result["measurement_complete"]) is not bool:
                raise ValueError
            if not finite(result["freed_gb"], True) or not finite(result["measured_at"], True):
                raise ValueError
            if (result["freed_gb"] is None) != (result["measured_at"] is None):
                raise ValueError
            if result["measurement_complete"] and result["freed_gb"] is None:
                raise ValueError
        else:
            if result["model"] != args.model or result["status"] not in ("ready", "blocked", "failed", "partial", "timeout"):
                raise ValueError
            if not finite(result["elapsed_seconds"]):
                raise ValueError
            if args.command == "wake":
                if type(result["ready"]) is not bool or type(result["cold_start"]) is not bool:
                    raise ValueError
                if result["status"] == "ready" and not result["ready"]:
                    raise ValueError
            else:
                if result["state"] is not None and not isinstance(result["state"], str):
                    raise ValueError
                if args.command == "preload" and type(result["already_resident"]) is not bool:
                    raise ValueError
        if result.get("error") is not None and not isinstance(result["error"], str):
            raise ValueError
    except (KeyError, TypeError, ValueError):
        raise ClientError("Invalid %s response; outcome may be unknown. Check status/events before retrying" % args.command) from None
    return result


def format_action_result(args, result):
    if args.dry_run:
        lines = ["Dry run: no model actions or persistent writes"]
        lines += ["Would: " + json.dumps(item, ensure_ascii=False, sort_keys=True) for item in result["would"]]
        lines += ["Blocked: " + json.dumps(item, ensure_ascii=False, sort_keys=True) for item in result["blocked_by"]]
        if "estimated_freed_gb" in result:
            lines.append("Estimated release: %s GiB (policy estimate, not measured)" % result["estimated_freed_gb"])
    elif args.command == "free":
        lines = ["Free status: " + result["status"]]
        quantity = "unknown" if result["freed_gb"] is None else "%s GiB" % result["freed_gb"]
        metric = "host MemAvailable" if args.ram else "GPU free memory"
        lines.append("Measured net %s change: %s" % (metric, quantity))
        lines.append("Measurement complete: %s; sampled at: %s" % (
            "yes" if result["measurement_complete"] else "no (not a final/current total)",
            "unknown" if result["measured_at"] is None else str(result["measured_at"]) + " Unix seconds"))
        lines.append("Net change includes external activity; it is not per-model attribution or reserved capacity")
        for key in ("slept", "stopped"):
            lines.append("%s: %s" % (key.capitalize(), ", ".join(result[key]) or "none"))
        lines += ["Skipped: " + json.dumps(item, ensure_ascii=False, sort_keys=True) for item in result["skipped"]]
    elif args.command == "wake":
        lines = ["Wake %s status: %s" % (result["model"], result["status"]),
                 "Ready: %s; cold start: %s; elapsed: %s seconds" % (
                     "yes" if result["ready"] else "no", "yes" if result["cold_start"] else "no",
                     result["elapsed_seconds"])]
    else:
        lines = ["%s %s status: %s" % (args.command.capitalize(), result["model"], result["status"]),
                 "Observed state: %s; elapsed: %s seconds" % (
                     result["state"] if result["state"] is not None else "unknown", result["elapsed_seconds"])]
        if args.command == "preload":
            lines.append("Weights already resident: %s" % ("yes" if result["already_resident"] else "no"))
    if result.get("error"):
        lines.append("Error: " + result["error"])
    if result.get("error_model") is not None:
        lines.append("Error model: " + str(result["error_model"]))
    return "\n".join(clean_text(line) for line in lines)


def result_exit_code(args, result):
    if args.command == "registry":
        return 0  # Successful inspection is not application/recovery success.
    if args.command == "models":
        return 1 if result.get("known") is False or result.get("error") else 0
    if args.command == "usage":
        return 0 if result["known"] else 1
    if args.command in ("pin", "unpin", "free", "wake", "sleep", "stop", "preload", "reserve", "unreserve") and args.dry_run:
        return 1 if result["blocked_by"] else 0
    if args.command == "reserve":
        return 0 if result["evacuation"]["status"] == "complete" else 1
    if args.command in ("free", "wake", "sleep", "stop", "preload"):
        return 0 if result["status"] == ("complete" if args.command == "free" else "ready") else 1
    return 0


def pin_duration(value):
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)(s|m|h|d)", value)
    if match is None:
        raise argparse.ArgumentTypeError("Duration requires a positive value and s/m/h/d, for example 8h")
    seconds = float(match[1]) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[match[2]]
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("Duration must be positive and finite")
    return seconds


def model_name(value):
    if not value.strip() or any(unicodedata.category(ch).startswith("C") for ch in value):
        raise argparse.ArgumentTypeError("Model name must be nonempty and contain no control characters")
    return value


def validate_discovered(result):
    """Validate the optional discovery list; never infer a missing candidate."""
    rows = result.get("discovered")
    if rows is None:
        return None  # Servers without discovery keep the older list shape.
    keys = {"name", "path", "base", "util", "weights_gb", "concurrency_limit", "concurrency_queue", "status", "reason"}
    # concurrency_limit/concurrency_queue are newer optional fields; older servers omit them entirely.
    optional = {"concurrency_limit", "concurrency_queue"}
    try:
        if not isinstance(rows, list) or len(rows) > 1000:
            raise ValueError
        for row in rows:
            if not isinstance(row, dict) or set(row) - keys or keys - set(row) - optional:
                raise ValueError
            for key in ("name", "path"):
                if not isinstance(row[key], str) or not row[key].strip():
                    raise ValueError
            if row["status"] not in ("pending", "configured", "invalid", "orphaned"):
                raise ValueError
            for key in ("base", "reason"):
                if row[key] is not None and not isinstance(row[key], str):
                    raise ValueError
            for key in ("util", "weights_gb"):
                value = row[key]
                if value is not None and (type(value) not in (int, float) or not math.isfinite(value)):
                    raise ValueError
            limit = row.get("concurrency_limit")
            if limit is not None and (type(limit) is not int or not 1 <= limit <= 4096):
                raise ValueError
            queue = row.get("concurrency_queue")
            if queue is not None and (type(queue) is not int or not 0 <= queue <= 65536):
                raise ValueError
    except (KeyError, TypeError, ValueError, OverflowError):
        raise ClientError("Invalid discovered model list; no candidates inferred") from None
    return rows


def validate_registry_details(args, result):
    """Validate optional owner metadata; never synthesize plans or observations."""
    def digest(value, nullable=False):
        return (nullable and value is None) or (isinstance(value, str) and re.fullmatch(r"[0-9a-fA-F]{64}", value))

    def port(value):
        return value is None or (type(value) is int and 1 <= value <= 65535)

    def blockers(value):
        return isinstance(value, list) and all(isinstance(item, dict) and isinstance(item.get("reason"), str) for item in value)

    if args.command != "models":
        return
    validate_discovered(result)
    if "inventory" not in result:
        return  # Older basic list responses remain compatible.
    try:
        detail = result["inventory"]
        if not isinstance(detail, dict):
            raise ValueError
        if not digest(detail["config_sha256"]) or type(detail["fenced"]) is not bool:
            raise ValueError
        if not isinstance(detail["recovery"], dict) or not isinstance(detail["pending_changes"], list):
            raise ValueError
        if not all(isinstance(job, dict) for job in detail["pending_changes"]) or not isinstance(detail["models"], list):
            raise ValueError
        row_keys = {"name", "source", "temporary", "base", "daemon_port", "created_at", "last_used_at",
                    "concurrency_limit", "concurrency_queue", "runtime_state", "removable", "blocked_by"}
        for row in detail["models"]:
            if not isinstance(row, dict) or set(row) - row_keys:
                raise ValueError
            if not isinstance(row["name"], str) or not row["name"].strip() or row["source"] != "config":
                raise ValueError
            if type(row["temporary"]) is not bool or type(row["removable"]) is not bool:
                raise ValueError
            if row["base"] is not None and not isinstance(row["base"], str):
                raise ValueError
            if not port(row["daemon_port"]) or not isinstance(row["runtime_state"], str) or not blockers(row["blocked_by"]):
                raise ValueError
            for key in ("created_at", "last_used_at"):
                value = row[key]
                if value is not None and (type(value) not in (int, float) or not math.isfinite(value)):
                    raise ValueError
            limit = row.get("concurrency_limit")
            if limit is not None and (type(limit) is not int or not 1 <= limit <= 4096):
                raise ValueError
            queue = row.get("concurrency_queue")
            if queue is not None and (type(queue) is not int or not 0 <= queue <= 65536):
                raise ValueError
    except (KeyError, TypeError, ValueError, OverflowError):
        raise ClientError("Invalid optional registry inventory details; no values inferred") from None


def format_registry_details(args, result):
    def value(item):
        return "unknown" if item is None else clean_text(item)

    lines = []
    if args.command == "models" and "inventory" in result:
        inventory = result["inventory"]
        lines.append("Configuration inventory; observations are separate, not adoption proof")
        for row in inventory["models"]:
            lines.append("%s [%s; source=config] base=%s port=%s; observed=%s" % (
                value(row["name"]), "temporary" if row["temporary"] else "permanent",
                value(row["base"]), value(row["daemon_port"]), value(row["runtime_state"])))
            lines.append("  last use=%s (Unix seconds)" % value(row["last_used_at"]))
            reasons = ", ".join(item["reason"] for item in row["blocked_by"]) or "none"
            lines.append("  model-level removable=%s; protection=%s" % ("yes" if row["removable"] else "no", reasons))
        lines.append("Pending FIFO changes: %s; fenced=%s; model eligibility is not global commit readiness" % (
            len(inventory["pending_changes"]), "yes" if inventory["fenced"] else "no"))
    if args.command == "models":
        discovered = result.get("discovered")
        if discovered:
            lines.append("Shared roots (models are registered automatically when the service is idle)")
            for row in discovered:
                lines.append("%s  %s  %s  %s" % (
                    value(row["status"]), value(row["name"]), value(row["path"]), value(row["reason"]) or "-"))
        elif discovered is not None:
            lines.append("Nothing new under the shared roots")
    return "\n".join(clean_text(line) for line in lines)


def validate_registry_result(args, result):
    if args.command == "models":
        validate_registry_details(args, result)
    try:
        if args.command == "registry":
            queue = result["queue"]
            if type(result["writes_enabled"]) is not bool or type(queue["schema_version"]) is not int or queue["schema_version"] != 1:
                raise ValueError
            observed = queue["observed_at_monotonic"]
            if type(observed) not in (int, float) or not math.isfinite(observed):
                raise ValueError
            if not isinstance(queue["jobs"], list) or not all(isinstance(job, dict) for job in queue["jobs"]):
                raise ValueError
            if not isinstance(queue["pending_ids"], list) or not all(isinstance(value, str) for value in queue["pending_ids"]):
                raise ValueError
            if type(queue["fenced"]) is not bool or not isinstance(queue["recovery"], dict):
                raise ValueError
        else:
            if not isinstance(result["records"], dict) or type(result["writes_enabled"]) is not bool:
                raise ValueError
            if not all(isinstance(name, str) and isinstance(record, dict) for name, record in result["records"].items()):
                raise ValueError
        blockers = result["blocked_by"]
        if not isinstance(blockers, list) or not all(isinstance(item["reason"], str) for item in blockers):
            raise ValueError
    except (KeyError, TypeError, ValueError):
        raise ClientError("Invalid registry read response") from None
    return result


def format_registry_result(args, result):
    if args.command == "registry":
        label = "Registry queue/recovery inspection; no apply or recovery action"
        label += "\nQueue/config fence: " + ("yes (retained)" if result["queue"]["fenced"] else "no")
        reasons = ", ".join(clean_text(item["reason"]) for item in result["blocked_by"])
        label += "\nGlobal blockers: " + (reasons or "none reported (not a readiness guarantee)")
        label += "\nQueue status is a config-stage projection, not global action readiness"
        label += "\nTimes are process-local monotonic; missing jobs do not prove application"
    else:
        label = "Temporary model registry (configured file, not active adoption)"
        label += "\nRegistry writes enabled: " + ("yes" if result["writes_enabled"] else "no")
    details = format_registry_details(args, result)
    return label + ("\n" + details if details else "") + "\n" + json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False)


def format_registry_error(error):
    text = str(error)
    if isinstance(error, ClientError) and isinstance(error.payload, dict):
        text += "\n" + json.dumps(error.payload, ensure_ascii=False, indent=2, allow_nan=False)
    return text


def validate_unreserve_result(args, result):
    try:
        if args.dry_run:
            if not isinstance(result["would"], list) or not isinstance(result["blocked_by"], list):
                raise ValueError
            for item in result["would"]:
                if item["kind"] != "unreserve" or item["id"] != args.id:
                    raise ValueError
            if not all(isinstance(item["reason"], str) for item in result["blocked_by"]):
                raise ValueError
        elif result["id"] != args.id or not isinstance(result["by"], str) or not result["by"].strip():
            raise ValueError
    except (KeyError, TypeError, ValueError):
        raise ClientError("Invalid unreserve response; inspect current reservations before retrying") from None
    return result


def validate_pin_result(args, result):
    try:
        if args.dry_run:
            if not isinstance(result["would"], list) or not isinstance(result["blocked_by"], list):
                raise ValueError
            for item in result["would"]:
                if item["kind"] != args.command or item["model"] != args.model:
                    raise ValueError
                if args.command == "pin":
                    if type(item["until"]) not in (int, float) or not math.isfinite(item["until"]):
                        raise ValueError
                    datetime.fromtimestamp(item["until"], timezone.utc)
            for item in result["blocked_by"]:
                if not isinstance(item["reason"], str):
                    raise ValueError
            return result
        if result["model"] != args.model or not isinstance(result["by"], str) or not result["by"].strip():
            raise ValueError
        if args.command == "pin":
            until = result["until"]
            if type(until) not in (int, float) or not math.isfinite(until):
                raise ValueError
            datetime.fromtimestamp(until, timezone.utc)
    except (KeyError, TypeError, ValueError, OverflowError, OSError):
        raise ClientError("Invalid pin response; check status before retrying the request") from None
    return result


def format_pin_result(args, result):
    if args.dry_run:
        lines = ["Dry run: pin records unchanged; preview labels are hypothetical"]
        for item in result["would"]:
            line = "Would %s %s" % (item["kind"], item["model"])
            if item.get("until") is not None:
                line += " until " + datetime.fromtimestamp(item["until"], timezone.utc).isoformat()
            lines.append(line)
        for blocker in result["blocked_by"]:
            lines.append("Blocked %s: %s" % (blocker.get("model") or "request", blocker["reason"]))
        return "\n".join(clean_text(line) for line in lines)
    if args.command == "pin":
        return clean_text("Pin recorded for %s until %s; owner %s" % (
            result["model"], datetime.fromtimestamp(result["until"], timezone.utc).isoformat(), result["by"]))
    return clean_text("Unpinned %s; actor %s" % (result["model"], result["by"]))


def build_parser(parser_class=argparse.ArgumentParser):
    parser = parser_class(prog="llm", description="Inspect the LLM scheduler")
    parser.add_argument("--version", action="version", version="1.8.0")
    parser.add_argument("--url", help="Scheduler URL (overrides LLM_URL and config)")
    parser.add_argument("--config", help="Config file (default: ~/.config/llm/config)")
    parser.add_argument("--timeout", help="HTTP timeout in seconds (model actions and reserve use --wait instead)")
    commands = parser.add_subparsers(dest="command")
    status = commands.add_parser("status", help="Show GPU, memory and model status")
    status.add_argument("--json", action="store_true", help="Print the complete JSON snapshot")
    usage = commands.add_parser("usage", help="Show request and token usage totals")
    usage.add_argument("--days", type=usage_days, default=7, help="Usage window in days, 1-365 (default: 7)")
    usage.add_argument("--by", choices=("user", "model", "day"), default="user",
                       help="Group rows by user, model or day (default: user)")
    usage.add_argument("--breakdown", action="store_true", help="Show each row's per-model or per-user sub-rows")
    usage.add_argument("--json", action="store_true", help="Print the complete usage response")
    for command in ("pin", "unpin"):
        intent = commands.add_parser(command, help="Set pin expiry" if command == "pin" else "Remove a pin record")
        intent.add_argument("model", type=model_name)
        if command == "pin":
            intent.add_argument("--for", dest="duration", required=True, type=pin_duration,
                                help="Required duration, for example 8h or 30m")
        intent.add_argument("--dry-run", action="store_true", help="Preview without changing any pin record")
        intent.add_argument("--json", action="store_true", help="Print the server response")
    for command, wait in (("free", 150), ("wake", 930)):
        action = commands.add_parser(command, help="Release eligible models" if command == "free" else "Wait for model readiness")
        if command == "free":
            action.add_argument("--gpu", type=gpu_index, help="GPU index (default: all observed GPUs)")
            action.add_argument("--ram", action="store_true", help="Reclaim host RAM by stopping eligible models")
            action.add_argument("--need", type=memory_amount, help="Additional GiB desired, for example 80G")
        else:
            action.add_argument("model", type=model_name)
        action.add_argument("--wait", type=action_timeout, default=wait,
                            help="HTTP response wait in seconds (default: %s); does not change server deadline" % wait)
        action.add_argument("--dry-run", action="store_true", help="Preview without model actions or persistent writes")
        action.add_argument("--json", action="store_true", help="Print the full server outcome, including partial failures")
    for command, wait in (("sleep", 150), ("stop", 150), ("preload", 960)):
        action = commands.add_parser(command, help={
            "sleep": "Move one awake model to sleeping (weights stay in host RAM)",
            "stop": "Stop one model; the next request pays a cold start",
            "preload": "Make weights resident without holding VRAM"}[command])
        action.add_argument("model", type=model_name)
        action.add_argument("--wait", type=action_timeout, default=wait,
                            help="HTTP response wait in seconds (default: %s); does not change server deadline" % wait)
        action.add_argument("--dry-run", action="store_true", help="Preview without model actions or persistent writes")
        action.add_argument("--json", action="store_true", help="Print the full server outcome, including partial failures")
    reserve = commands.add_parser("reserve", help="Reserve a GPU; inspect the separate evacuation outcome")
    reserve.add_argument("--gpu", required=True, type=gpu_index)
    reserve.add_argument("--size", required=True, type=reserve_size, help="Requested positive GiB annotation, e.g. 80G")
    reserve.add_argument("--for", dest="duration", required=True, type=pin_duration, help="Required positive duration, e.g. 4h")
    reserve.add_argument("--dry-run", action="store_true", help="Preview without persistence, model actions or ID allocation")
    reserve.add_argument("--json", action="store_true", help="Print the complete receipt and evacuation result")
    reserve.add_argument("--wait", type=action_timeout, default=150, help="HTTP response wait seconds (default:150); does not change server deadline")
    models = commands.add_parser("models", help="List configured models and shared-root discovery through scheduler")
    models.add_argument("--json", action="store_true")
    registry = commands.add_parser("registry", help="Inspect read-only queue/recovery status; never apply or clear a fence")
    registry.add_argument("--json", action="store_true")
    unreserve = commands.add_parser("unreserve", help="Remove a reservation without waking models")
    unreserve.add_argument("id", type=model_name, help="Reservation ID from status/reserve response")
    unreserve.add_argument("--dry-run", action="store_true")
    unreserve.add_argument("--json", action="store_true")
    return parser


def app_version(parser_class=argparse.ArgumentParser):
    """Return the running application version from its single argparse literal.

    The publisher already verifies the ``--version`` action string in this file;
    reading it here keeps the CLI and TUI on one source instead of a second
    hardcoded release literal.
    """
    for action in build_parser(parser_class)._actions:
        if action.dest == "version":
            return str(action.version)
    return "unknown"


def execute_command(args, client, *, now=None):
    if args.command == "registry":
        return validate_registry_result(args, client.request("GET", "/v1/registry"))
    if args.command == "models":
        return validate_registry_result(args, client.request("GET", "/v1/models"))
    if args.command == "unreserve":
        path = "/v1/reserve/" + quote(args.id, safe="") + ("?dry_run=1" if args.dry_run else "")
        try:
            result = client.request("DELETE", path)
        except ClientError as exc:
            if exc.status is not None or args.dry_run:
                raise
            raise ClientError(str(exc) + "; deletion outcome unknown: inspect reservations; no automatic write retry") from None
        return validate_unreserve_result(args, result)
    if args.command == "reserve":
        payload = {"gpu": args.gpu, "size_gb": args.size, "until": intent_expiry(args.duration, now),
                   "by": PIN_COMPATIBILITY_LABEL}
        try:
            result = client.request("POST", "/v1/reserve" + ("?dry_run=1" if args.dry_run else ""),
                                    payload, timeout=args.wait)
        except ClientError as exc:
            if exc.status is not None or args.dry_run:
                raise
            raise ClientError(str(exc) + "; reservation may have persisted: check status before retrying; no automatic POST retry") from None
        return validate_reserve_result(args, result)
    if args.command in ("free", "wake", "sleep", "stop", "preload"):
        query = "?dry_run=1" if args.dry_run else ""
        if args.command == "free":
            payload = {"ram": args.ram}
            if args.gpu is not None:
                payload["gpu"] = args.gpu
            if args.need is not None:
                payload["need_gb"] = args.need
            path = "/v1/free"
        else:
            path, payload = "/v1/" + args.command + "/" + quote(args.model, safe=""), None
        try:
            result = client.request("POST", path + query, payload, timeout=args.wait)
        except ClientError as exc:
            if exc.status is not None or args.dry_run:
                raise
            raise ClientError(str(exc) + "; outcome unknown: the server may still finish. Check status/events before retrying; no automatic retry") from None
        return validate_action_result(args, result)
    if args.command in ("pin", "unpin"):
        query = "?dry_run=1" if args.dry_run else ""
        if args.command == "pin":
            until = intent_expiry(args.duration, now)
            result = client.request("POST", "/v1/pin" + query,
                                    {"model": args.model, "until": until, "by": PIN_COMPATIBILITY_LABEL})
        else:
            result = client.request("DELETE", "/v1/pin/" + quote(args.model, safe="") + query)
        return validate_pin_result(args, result)
    if args.command == "usage":
        path = "/v1/usage/report?days=%s&by=%s" % (args.days, args.by)
        try:
            result = client.request("GET", path)
        except ClientError as exc:
            if exc.status != 503 or not isinstance(exc.payload, dict) or exc.payload.get("known") is not False:
                raise
            result = exc.payload
        return validate_usage(result, days=args.days, by=args.by)
    return client.request("GET", "/v1/state")


def format_result(args, result, width=100):
    if getattr(args, "json", False):
        return json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False)
    if args.command == "usage":
        return format_usage(result, width=width, breakdown=getattr(args, "breakdown", False))
    if args.command in ("pin", "unpin"):
        return format_pin_result(args, result)
    if args.command in ("free", "wake", "sleep", "stop", "preload"):
        return format_action_result(args, result)
    if args.command == "reserve":
        return format_reserve_result(args, result)
    if args.command in ("models", "registry"):
        return format_registry_result(args, result)
    if args.command == "unreserve":
        if args.dry_run:
            return format_action_result(args, result)
        return clean_text("Unreserve acknowledged: %s; actor %s; no model wake/restart" % (result["id"], result["by"]))
    return format_status(result, width=width)


def tui_app():
    try:
        return importlib.import_module("tui.app").SchedulerApp
    except ImportError:
        return None


def execute_wake_with_progress(args, client):
    """Run one wake request while a single scheduler SSE reader observes stages."""
    reader = EventReader(client, stream_timeout=0.5, retry_delay=0.1,
                         max_retry_delay=1, queue_size=64)
    reader.start()
    started = time.time()
    outcome = {}

    def invoke():
        try:
            outcome["result"] = execute_command(args, client)
        except BaseException as exc:  # Re-raise on the caller thread below.
            outcome["error"] = exc

    request = threading.Thread(target=invoke, name="llm-wake-request", daemon=True)
    request.start()
    generation = None
    progress_state = {"log_epoch": None, "sequence": 0, "retired_epochs": set()}
    last = None
    try:
        while request.is_alive():
            update = reader.drain()
            if generation is None:
                generation = update["generation"]
            elif update["generation"] != generation:
                generation = update["generation"]
                progress_state = {"log_epoch": None, "sequence": 0, "retired_epochs": set()}
                if not args.json and last != "progress unavailable":
                    print("Wake progress unavailable; final server result remains authoritative", file=sys.stderr)
                    last = "progress unavailable"
            for item in update["events"]:
                progress = parse_wake_progress(item, args.model, since=started)
                if progress is None:
                    continue
                if not accept_wake_progress(progress, progress_state):
                    if not args.json and last != "progress unavailable":
                        print("Wake progress unavailable; source epoch replayed or changed", file=sys.stderr)
                        last = "progress unavailable"
                    continue
                label = progress["label"]
                if not args.json and label != last:
                    print("Wake observed: %s (source: llama-swap; readiness is the server result)" % label,
                          file=sys.stderr)
                    last = label
            time.sleep(0.01)
    finally:
        # Closing the observer never retries or cancels the already-submitted
        # POST; it only bounds local reader/worker cleanup on errors or Ctrl-C.
        reader.close(timeout=2)
        request.join(timeout=2)
    if "error" in outcome:
        raise outcome["error"]
    if request.is_alive():
        raise ClientError("Wake request still running; outcome unknown. Check status/events before retrying")
    return outcome["result"]


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        config = load_config(path=args.config, url=args.url, timeout=args.timeout)
        client = SchedulerClient(**config)
        if args.command is None and sys.stdout.isatty():
            app = tui_app()
            if app is not None:
                app(client=client, api=SimpleNamespace(**globals())).run()
                return 0
        if args.command == "wake" and not args.dry_run:
            result = execute_wake_with_progress(args, client)
        else:
            result = execute_command(args, client)
        print(format_result(args, result, width=shutil.get_terminal_size((100, 30)).columns))
        if args.command is None:
            print("TUI: install with pip install 'llmsvc[tui]' and run llm in a terminal.")
        return result_exit_code(args, result)
    except ClientError as exc:
        if args.command in ("models", "registry"):
            if getattr(args, "json", False) and isinstance(exc.payload, dict):
                print(json.dumps(exc.payload, ensure_ascii=False, indent=2, allow_nan=False))
            else:
                print("llm: " + clean_text(format_registry_error(exc)), file=sys.stderr)
            return 1
        print("llm: " + clean_text(exc), file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError, OverflowError):
        print("llm: Invalid scheduler state response; check the server API version", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
