def event_lines(response):
    """Read available bytes without waiting for a full buffer; accept LF/CRLF/CR."""
    line, after_cr = bytearray(), False
    while True:
        chunk = response.read1(4096)
        if not chunk:
            return  # An incomplete line/event at EOF is replayed after reconnect.
        for value in chunk:
            if after_cr:
                after_cr = False
                if value == 10:
                    continue
            if value in (10, 13):
                yield bytes(line)
                line.clear()
                after_cr = value == 13
            else:
                line.append(value)
                if len(line) > 65536:
                    raise ClientError("Scheduler SSE line exceeds 64 KiB")


def iter_events(response):
    """Decode bounded scheduler SSE frames; heartbeats never advance the cursor."""
    data, event_id, size = [], None, 0
    first = True
    for raw in event_lines(response):
        size += len(raw) + 1
        if size > 262144:
            raise ClientError("Scheduler SSE frame exceeds 256 KiB")
        try:
            line = raw.decode("utf-8")
        except UnicodeError:
            raise ClientError("Scheduler SSE contains invalid UTF-8") from None
        if first:
            line = line.removeprefix("\ufeff")
            first = False
        if not line:
            if data:
                try:
                    item = json.loads("\n".join(data), parse_constant=invalid_constant)
                    valid = (
                        event_id is not None and isinstance(item, dict)
                        and type(item.get("id")) is int and item["id"] == event_id
                        and isinstance(item.get("kind"), str)
                        and type(item.get("timestamp")) in (int, float)
                        and math.isfinite(item["timestamp"])
                    )
                except (ValueError, OverflowError):
                    valid = False
                if not valid:
                    raise ClientError("Scheduler SSE contains an invalid event record")
                yield item
            data, event_id, size = [], None, 0
            continue
        if line.startswith(":"):
            continue
        field, _, value = line.partition(":")
        value = value.removeprefix(" ")
        if field == "data":
            data.append(value)
        elif field == "id":
            if not value.isascii() or not value.isdigit():
                raise ClientError("Scheduler SSE contains an invalid event ID")
            try:
                event_id = int(value)
            except ValueError:
                raise ClientError("Scheduler SSE contains an invalid event ID") from None


class EventReader:
    """One background subscription to scheduler SSE with a bounded delivery queue."""

    def __init__(self, client, *, stream_timeout=30, retry_delay=1, max_retry_delay=30, queue_size=256):
        self.client = client
        self.stream_timeout = positive_timeout(stream_timeout)
        self.retry_delay = positive_timeout(retry_delay)
        self.max_retry_delay = max(self.retry_delay, positive_timeout(max_retry_delay))
        if not isinstance(queue_size, int) or queue_size < 1:
            raise ClientError("Event queue size must be positive")
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._wake = threading.Event()
        self._queue = deque(maxlen=queue_size)
        self._cursor = 0
        self._generation = 0
        self._dropped = 0
        self._missed = 0
        self._status = "SSE connecting"
        self._socket = None
        self.thread = None

    def start(self):
        if self.thread is not None:
            raise ClientError("Event reader is already started")
        self.thread = threading.Thread(target=self._run, name="llm-scheduler-events", daemon=True)
        self.thread.start()

    def drain(self):
        with self._lock:
            result = {"generation": self._generation, "events": list(self._queue),
                      "status": self._status, "dropped": self._dropped,
                      "missed": self._missed, "cursor": self._cursor}
            self._queue.clear()
            return result

    def _interrupt(self):
        with self._lock:
            connection = self._socket
        if connection is not None:
            try:
                connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    def reset_cursor(self):
        """Call only after a known daemon restart, not on ordinary disconnects."""
        with self._lock:
            self._generation += 1
            self._cursor = 0
            self._queue.clear()
            self._dropped = 0
            self._missed = 0
            self._status = "SSE cursor reset after known restart"
        self._wake.set()
        self._interrupt()

    def close(self):
        self._stop.set()
        self._wake.set()
        self._interrupt()
        if self.thread is not None:
            self.thread.join(timeout=self.client.timeout + self.stream_timeout + 1)
            return not self.thread.is_alive()
        return True

    def _run(self):
        delay = self.retry_delay
        while not self._stop.is_set():
            with self._lock:
                cursor, generation = self._cursor, self._generation
            response = None
            try:
                request = Request(self.client.url + "/v1/events?since=" + str(cursor),
                                  headers={"Accept": "text/event-stream", "Last-Event-ID": str(cursor)})
                response = self.client.opener(request, timeout=self.client.timeout)
                if response.headers.get_content_type() != "text/event-stream":
                    raise ClientError("Scheduler SSE response has an invalid content type")
                # urllib returns an HTTPResponse; shutting down its transport unblocks
                # reads before closing the buffered stream, including TLS sockets.
                connection = getattr(getattr(getattr(response, "fp", None), "raw", None), "_sock", None)
                if connection is not None:
                    connection.settimeout(self.stream_timeout)
                with self._lock:
                    if generation != self._generation or self._stop.is_set():
                        continue
                    self._socket = connection
                    self._status = "SSE connected"
                for item in iter_events(response):
                    with self._lock:
                        if generation != self._generation or self._stop.is_set():
                            break
                        if item["id"] <= self._cursor:
                            continue
                        self._missed += item["id"] - self._cursor - 1
                        if len(self._queue) == self._queue.maxlen:
                            self._dropped += 1
                        self._queue.append(item)
                        self._cursor = item["id"]
                        delay = self.retry_delay
                with self._lock:
                    if generation == self._generation:
                        self._status = "SSE disconnected; reconnecting"
            except (ClientError, HTTPError, URLError, OSError, HTTPException, ValueError) as exc:
                if isinstance(exc, HTTPError):
                    exc.close()
                with self._lock:
                    if generation == self._generation:
                        self._status = "SSE reconnecting: " + clean_text(exc)
            finally:
                with self._lock:
                    self._socket = None
                if response is not None:
                    response.close()
            self._wake.wait(delay)
            self._wake.clear()
            delay = min(self.max_retry_delay, delay * 2)


def cell_width(text):
    return sum(0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def fit(value, width):
    text = clean_text(value)
    if cell_width(text) <= width:
        return text + " " * (width - cell_width(text))
    result = ""
    for ch in text:
        if cell_width(result + ch) > width - 1:
            break
        result += ch
    return result + "~" + " " * max(0, width - 1 - cell_width(result))


def number(value):
    return "?" if value is None else format(value, ".1f").rstrip("0").rstrip(".")


def age(seconds):
    if seconds is None:
        return "?"
    seconds = max(0, seconds)
    if seconds < 60:
        return "%ss" % int(seconds)
    if seconds < 3600:
        return "%sm" % number(seconds / 60)
    if seconds < 86400:
        return "%.1fh" % (seconds / 3600)
    return "%.1fd" % (seconds / 86400)


def expiry(timestamp):
    return "?" if timestamp is None else datetime.fromtimestamp(timestamp, timezone.utc).strftime("%m-%d %H:%MZ")


def wrap_line(line, width):
    """Wrap even long identifiers without exceeding terminal display cells."""
    lines, current = [], ""
    for ch in clean_text(line):
        if cell_width(ch) > width:
            ch = "?"
        if current and cell_width(current + ch) > width:
            lines.append(current.rstrip())
            current = ""
        current += ch
    lines.append(current.rstrip())
    return lines


def format_status(snapshot, width=100, now=None):
    width = max(1, width)
    if now is None:
        now = snapshot.get("sampled_at")
    if now is None:
        now = time.time()
    activity = {item["model"]: item for item in snapshot.get("activity", [])}
    pins = {item["model"]: item for item in snapshot.get("pins", []) if item["until"] > now}
    lines = []
    for gpu in snapshot.get("gpus", []):
        lines.append("GPU%s  %s/%s GiB  llmsvc %s  external %s  free %s" % (
            gpu["index"], number(gpu.get("used_gb")), number(gpu.get("total_gb")),
            number(gpu.get("managed_gb")), number(gpu.get("external_gb")), number(gpu.get("free_gb")),
        ))
        for process in gpu.get("external_processes", []):
            lines.append("  external: %s (%s), %s GiB" % (
                process.get("name") or "?", process.get("user") or "?", number(process.get("used_gb")),
            ))
    if not snapshot.get("gpus"):
        lines.append("GPU observations unavailable")
    memory = snapshot.get("memory") or {}
    lines.append("RAM   llmsvc %s/%s GiB budget  host available %s GiB" % (
        number(memory.get("sleeping_weights_gb")), number(memory.get("budget_gb")), number(memory.get("host_available_gb")),
    ))
    lines.append("")
    if width >= 100:
        columns = [("MODEL", width - 73), ("STATE", 8), ("GPU", 3), ("MEM", 6), ("USED", 6), ("10m", 4), ("FROM", 10), ("PIN (UTC)", 22)]
    else:
        columns = [("MODEL", max(8, width - 37)), ("STATE", 8), ("GPU", 3), ("MEM", 6), ("PIN", 8)]
    lines.append(" ".join(fit(label, size) for label, size in columns).rstrip())
    for model in snapshot.get("models", []):
        name = model["name"]
        stats = activity.get(name, {})
        pin = pins.get(name)
        used = age(None if stats.get("last_request_at") is None else now - stats["last_request_at"])
        count = "?" if stats.get("requests_last_10m") is None else str(stats["requests_last_10m"])
        source = ",".join(stats.get("by", [])) or "-"
        pin_text = "%s (%s)" % (expiry(pin["until"]), pin.get("by", "?")) if pin else "-"
        display_name = fit(name, columns[0][1] - 2).rstrip() + " *" if model.get("is_default") else name
        values = [display_name, model.get("state", "unknown"),
                  "-" if model.get("gpu") is None else str(model["gpu"]), number(model.get("resident_gb")) + "G"]
        if width >= 100:
            values.extend([used, count, source, pin_text])
        else:
            values.append(age(pin["until"] - now) if pin else "-")
        lines.append(" ".join(fit(value, size) for value, (_, size) in zip(values, columns)).rstrip())
        if width < 100:
            lines.append("  used %s  10m %s  from %s  pin %s" % (used, count, source, pin_text))
        if model.get("state") == "stopped":
            lines.append("  cold start estimate: %s" % age(model.get("cold_start_seconds")))
    if not snapshot.get("models"):
        lines.append("No model observations")
    for reserve in snapshot.get("reserves", []):
        if reserve["until"] > now:
            lines.append("RESERVE %s GPU%s %s GiB until %s (%s)" % (
                reserve["id"], reserve["gpu"], number(reserve["size_gb"]), expiry(reserve["until"]), reserve["by"],
            ))
    for lease in snapshot.get("leases", []):
        if lease.get("status") not in ("released", "confirmed"):
            lines.append("LEASE %s GPU%s %s GiB %s until %s" % (
                lease["model"], lease["gpu"], number(lease.get("budget_gb")), lease.get("status", "pending"), expiry(lease.get("expires_at")),
            ))
    for blocked in snapshot.get("blocked_by", []):
        lines.append("BLOCKED %s: %s" % (blocked["model"], blocked["reason"]))
    for error in snapshot.get("errors", []):
        lines.append("WARNING " + clean_text(error))
    lines.append("* default model | ? unknown | sampled %s%s" % (
        expiry(snapshot.get("sampled_at")), " | read-only" if snapshot.get("read_only") else "",
    ))
    return "\n".join(part for line in lines for part in wrap_line(line, width))


USAGE_COUNTS = ("requests", "input_tokens", "output_tokens")


def validate_usage(result, *, days=None, by=None):
    """Reject incomplete/inconsistent counts instead of manufacturing a total."""
    try:
        valid = (type(result.get("known")) is bool and type(result.get("days")) is int
                 and result["days"] > 0 and result.get("by") in ("container", "ip", "model")
                 and isinstance(result.get("rows"), (list, tuple))
                 and isinstance(result.get("totals"), dict))
        if not valid or (days is not None and result["days"] != days) or (by is not None and result["by"] != by):
            raise ValueError
        totals = result["totals"]
        if not result["known"]:
            if result["rows"] or any(key not in totals or totals[key] is not None for key in USAGE_COUNTS):
                raise ValueError
            return result
        for counts in [totals, *result["rows"]]:
            if any(type(counts.get(key)) is not int or counts[key] < 0 for key in USAGE_COUNTS):
                raise ValueError
        for row in result["rows"]:
            if not isinstance(row.get(result["by"]), str) or type(row.get("source_known")) is not bool:
                raise ValueError
        if any(sum(row[key] for row in result["rows"]) != totals[key] for key in USAGE_COUNTS):
            raise ValueError
    except (AttributeError, KeyError, TypeError, ValueError):
        raise ClientError("Invalid usage response: counts, grouping or totals are inconsistent") from None
    return result


def usage_attribution(row, by):
    if by == "model":
        return "not grouped"
    if not row["source_known"]:
        return "unknown"
    if by == "container" and row[by].startswith("ip:"):
        return "IP only"
    return "known"


def format_usage(result, width=100):
    validate_usage(result)
    width = max(1, width)
    lines = ["Usage: last %s days by %s" % (result["days"], result["by"])]
    if not result["known"]:
        lines.extend(["Unavailable: " + clean_text(result.get("error") or "source unavailable"),
                      "Requests ?  Input tokens ?  Output tokens ?"])
    else:
        rows, totals, by = result["rows"], result["totals"], result["by"]
        labels = ("REQUESTS", "INPUT TOKENS", "OUTPUT TOKENS")
        sizes = [max(len(label), *(len(str(item[key])) for item in [totals, *rows]))
                 for key, label in zip(USAGE_COUNTS, labels)]
        source_width = width - sum(sizes) - 11 - 8
        if source_width >= 12:
            lines.append("  ".join([fit(by.upper(), source_width),
                                    *(label.rjust(size) for label, size in zip(labels, sizes)), "ATTRIBUTION"]))
            for row in rows:
                lines.append("  ".join([fit(row[by], source_width),
                                        *(str(row[key]).rjust(size) for key, size in zip(USAGE_COUNTS, sizes)),
                                        usage_attribution(row, by)]))
            lines.append("  ".join([fit("TOTAL", source_width),
                                    *(str(totals[key]).rjust(size) for key, size in zip(USAGE_COUNTS, sizes))]))
        else:
            for row in rows:
                lines.extend(["%s (%s)" % (row[by], usage_attribution(row, by)),
                              "  Requests: %s" % row["requests"],
                              "  Input tokens: %s" % row["input_tokens"],
                              "  Output tokens: %s" % row["output_tokens"]])
            lines.extend(["TOTAL", "Requests: %s" % totals["requests"],
                          "Input tokens: %s" % totals["input_tokens"],
                          "Output tokens: %s" % totals["output_tokens"]])
        if not rows:
            lines.append("No requests in this window (source available)")
        lines.append("Attribution: not grouped by source" if by == "model" else
                     "Attribution: unknown = origin absent; IP only = container mapping unavailable")
    return "\n".join(part for line in lines for part in wrap_line(line, width))


def build_parser(parser_class=argparse.ArgumentParser):
    parser = parser_class(prog="llm", description="Inspect the LLM scheduler")
    parser.add_argument("--version", action="version", version="0.1.0a1")
    parser.add_argument("--url", help="Scheduler URL (overrides LLM_URL and config)")
    parser.add_argument("--config", help="Config file (default: ~/.config/llm/config)")
    parser.add_argument("--timeout", help="HTTP timeout in seconds")
    commands = parser.add_subparsers(dest="command")
    status = commands.add_parser("status", help="Show GPU, memory and model status")
    status.add_argument("--json", action="store_true", help="Print the complete JSON snapshot")
    usage = commands.add_parser("usage", help="Show request and token usage totals")
    usage.add_argument("--days", type=int, choices=(7, 30), default=7, help="Usage window (default: 7)")
    usage.add_argument("--by", choices=("container", "ip", "model"), default="container")
    usage.add_argument("--json", action="store_true", help="Print the complete usage response")
    return parser


def execute_command(args, client):
    if args.command == "usage":
        try:
            result = client.request("GET", "/v1/usage?days=%s&by=%s" % (args.days, args.by))
        except ClientError as exc:
            if exc.status != 503 or not isinstance(exc.payload, dict) or exc.payload.get("known") is not False:
                raise
            result = exc.payload
        return validate_usage(result, days=args.days, by=args.by)
    return client.request("GET", "/v1/state")


def format_result(args, result, width=100):
    if getattr(args, "json", False):
        return json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False)
    if args.command == "usage":
        return format_usage(result, width=width)
    return format_status(result, width=width)


def tui_app():
    try:
        return importlib.import_module("tui.app").SchedulerApp
    except ImportError:
        return None


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        config = load_config(path=args.config, url=args.url, timeout=args.timeout)
        client = SchedulerClient(**config)
        if args.command is None and sys.stdout.isatty():
            app = tui_app()
            if app is not None:
                app(client=client, api=SimpleNamespace(**globals())).run()
                return 0
        result = execute_command(args, client)
        print(format_result(args, result, width=shutil.get_terminal_size((100, 30)).columns))
        if args.command is None:
            print("TUI: install with pip install 'llmsvc[tui]' and run llm in a terminal.")
        return 1 if args.command == "usage" and not result["known"] else 0
    except ClientError as exc:
        print("llm: " + clean_text(exc), file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError, OverflowError):
        print("llm: Invalid scheduler state response; check the server API version", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
