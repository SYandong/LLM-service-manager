def cell_width(text):
    return sum(0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def fit(value, width):
    text = clean_text(value)
    if cell_width(text) <= width:
        return text + " " * (width - cell_width(text))
    result = ""
    for ch in text:
        if cell_width(result + ch) > width - 1:
            break
        result += ch
    return result + "~" + " " * max(0, width - 1 - cell_width(result))


def number(value):
    return "?" if value is None else format(value, ".1f").rstrip("0").rstrip(".")


def age(seconds):
    if seconds is None:
        return "?"
    seconds = max(0, seconds)
    if seconds < 60:
        return "%ss" % int(seconds)
    if seconds < 3600:
        return "%sm" % number(seconds / 60)
    if seconds < 86400:
        return "%.1fh" % (seconds / 3600)
    return "%.1fd" % (seconds / 86400)


def expiry(timestamp):
    return "?" if timestamp is None else datetime.fromtimestamp(timestamp, timezone.utc).strftime("%m-%d %H:%MZ")


def wrap_line(line, width):
    """Wrap even long identifiers without exceeding terminal display cells."""
    lines, current = [], ""
    for ch in clean_text(line):
        if cell_width(ch) > width:
            ch = "?"
        if current and cell_width(current + ch) > width:
            lines.append(current.rstrip())
            current = ""
        current += ch
    lines.append(current.rstrip())
    return lines


