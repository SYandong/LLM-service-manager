WAKE_PROGRESS_STAGES = {
    "wrapper_started": "wrapper started",
    "wake_attempted": "wake attempt observed",
    "start_attempted": "daemon start attempted",
    "process_started": "daemon process started",
    "health_wait": "waiting for health",
    "start_failed": "daemon start failed",
    "health_failed": "health check failed",
    "unavailable": "progress unavailable",
}


def parse_wake_progress(item, target, *, after_id=0, since=None):
    """Validate only the fixed scheduler wake-progress envelope.

    Raw model log text is never accepted here.  The scheduler's local epoch and
    sequence are useful for stale-event filtering, but do not prove continuity
    or readiness.
    """
    if not isinstance(item, dict) or item.get("kind") != "wake_progress":
        return None
    if not isinstance(target, str) or item.get("model") != target:
        return None
    if type(item.get("id")) is not int or item["id"] <= after_id:
        return None
    if (type(item.get("timestamp")) not in (int, float)
            or not math.isfinite(item["timestamp"])
            or (since is not None and item["timestamp"] < since)):
        return None
    detail = item.get("detail")
    if not isinstance(detail, dict):
        return None
    if not wake_progress_detail_valid(detail, target):
        return None
    stage = detail["stage"]
    if stage not in WAKE_PROGRESS_STAGES:
        return None
    return {"stage": stage, "label": WAKE_PROGRESS_STAGES[stage],
            "sequence": detail["sequence"], "log_epoch": detail["log_epoch"],
            "source": "llama-swap"}


def wake_progress_detail_valid(detail, target=None):
    if not isinstance(detail, dict) or detail.get("stage") not in WAKE_PROGRESS_STAGES:
        return False
    if (detail.get("source") != "llama-swap"
            or detail.get("progress_source") != "per_model_log"
            or detail.get("trusted_for_quiet") is not False):
        return False
    if target is not None and detail.get("source_model") != target:
        return False
    if not isinstance(detail.get("source_model"), str) or not detail["source_model"]:
        return False
    if not isinstance(detail.get("log_epoch"), str) or not detail["log_epoch"]:
        return False
    if type(detail.get("sequence")) is not int or detail["sequence"] < 1:
        return False
    received = detail.get("received_at")
    return type(received) in (int, float) and math.isfinite(received)


def format_wake_progress(progress):
    if (isinstance(progress, dict) and progress.get("stage") in WAKE_PROGRESS_STAGES
            and isinstance(progress.get("label"), str)):
        return progress["label"]
    if not wake_progress_detail_valid(progress) and not (
            isinstance(progress, dict) and progress.get("source") is None
            and progress.get("stage") in WAKE_PROGRESS_STAGES):
        return "progress unavailable"
    return WAKE_PROGRESS_STAGES[progress["stage"]]


def accept_wake_progress(progress, state):
    """Accept one monotonic epoch/sequence, rejecting retired replay epochs."""
    if not isinstance(progress, dict) or not isinstance(state, dict):
        return False
    epoch, sequence = progress.get("log_epoch"), progress.get("sequence")
    if not isinstance(epoch, str) or type(sequence) is not int or sequence < 1:
        return False
    retired = state.setdefault("retired_epochs", set())
    current = state.get("log_epoch")
    if current == epoch:
        if sequence <= state.get("sequence", 0):
            return False
    else:
        if current is not None:
            retired.add(current)
        if epoch in retired or sequence != 1:
            retired.add(epoch)
            return False
        state["log_epoch"] = epoch
        state["sequence"] = 0
    state["sequence"] = sequence
    return True


def cell_width(text):
    return sum(0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def fit(value, width):
    text = clean_text(value)
    if cell_width(text) <= width:
        return text + " " * (width - cell_width(text))
    result = ""
    for ch in text:
        if cell_width(result + ch) > width - 1:
            break
        result += ch
    return result + "~" + " " * max(0, width - 1 - cell_width(result))


def number(value):
    return "?" if value is None else format(value, ".1f").rstrip("0").rstrip(".")


def age(seconds):
    if seconds is None:
        return "?"
    seconds = max(0, seconds)
    if seconds < 60:
        return "%ss" % int(seconds)
    if seconds < 3600:
        return "%sm" % number(seconds / 60)
    if seconds < 86400:
        return "%.1fh" % (seconds / 3600)
    return "%.1fd" % (seconds / 86400)


def expiry(timestamp):
    return "?" if timestamp is None else datetime.fromtimestamp(timestamp, timezone.utc).strftime("%m-%d %H:%MZ")


def wrap_line(line, width):
    """Wrap even long identifiers without exceeding terminal display cells."""
    lines, current = [], ""
    for ch in clean_text(line):
        if cell_width(ch) > width:
            ch = "?"
        if current and cell_width(current + ch) > width:
            lines.append(current.rstrip())
            current = ""
        current += ch
    lines.append(current.rstrip())
    return lines


def wrap_prose(line, width):
    """Wrap prose on spaces; only a single over-long token is hard-wrapped."""
    line = clean_text(line)
    if width <= 0:
        return [""]
    if cell_width(line) <= width:
        return [line]
    parts = textwrap.wrap(line, width, break_long_words=False, break_on_hyphens=False)
    if not parts:
        return [""]
    result = []
    for part in parts:
        if cell_width(part) > width:
            result.extend(wrap_line(part, width))
        else:
            result.append(part)
    return result


def format_status(snapshot, width=100, now=None):
    width = max(1, width)
    if now is None:
        now = snapshot.get("sampled_at")
    if now is None:
        now = time.time()
    activity = {item["model"]: item for item in snapshot.get("activity", [])}
    pins = {item["model"]: item for item in snapshot.get("pins", []) if item["until"] > now}
    lines = []
    for gpu in snapshot.get("gpus", []):
        lines.append("GPU%s  %s/%s GiB  llmsvc %s  external %s  free %s" % (
            gpu["index"], number(gpu.get("used_gb")), number(gpu.get("total_gb")),
            number(gpu.get("managed_gb")), number(gpu.get("external_gb")), number(gpu.get("free_gb")),
        ))
        for process in gpu.get("external_processes", []):
            lines.append("  external: %s (%s), %s GiB" % (
                process.get("name") or "?", process.get("user") or "?", number(process.get("used_gb")),
            ))
    if not snapshot.get("gpus"):
        lines.append("GPU observations unavailable")
    memory = snapshot.get("memory") or {}
    lines.append("RAM   llmsvc %s/%s GiB budget  host available %s GiB" % (
        number(memory.get("sleeping_weights_gb")), number(memory.get("budget_gb")), number(memory.get("host_available_gb")),
    ))
    lines.append("")
    if width >= 100:
        columns = [("MODEL", width - 73), ("STATE", 8), ("GPU", 3), ("MEM", 6), ("USED", 6), ("10m", 4), ("FROM", 10), ("PIN (UTC)", 22)]
    else:
        columns = [("MODEL", max(8, width - 37)), ("STATE", 8), ("GPU", 3), ("MEM", 6), ("PIN", 8)]
    lines.append(" ".join(fit(label, size) for label, size in columns).rstrip())
    for model in snapshot.get("models", []):
        name = model["name"]
        stats = activity.get(name, {})
        pin = pins.get(name)
        used = age(None if stats.get("last_request_at") is None else now - stats["last_request_at"])
        count = "?" if stats.get("requests_last_10m") is None else str(stats["requests_last_10m"])
        source = ",".join(stats.get("by", [])) or "-"
        pin_text = "%s (%s)" % (expiry(pin["until"]), pin.get("by", "?")) if pin else "-"
        display_name = fit(name, columns[0][1] - 2).rstrip() + " *" if model.get("is_default") else name
        values = [display_name, model.get("state", "unknown"),
                  "-" if model.get("gpu") is None else str(model["gpu"]), number(model.get("resident_gb")) + "G"]
        if width >= 100:
            values.extend([used, count, source, pin_text])
        else:
            values.append(age(pin["until"] - now) if pin else "-")
        lines.append(" ".join(fit(value, size) for value, (_, size) in zip(values, columns)).rstrip())
        if width < 100:
            lines.append("  used %s  10m %s  from %s  pin %s" % (used, count, source, pin_text))
        if model.get("state") == "stopped":
            estimate = model.get("cold_start_seconds")
            if estimate is None:
                lines.append("  cold start estimate: ? (policy default)")
            else:
                source = model.get("cold_start_source")
                lines.append("  cold start estimate: %s (%s)" % (age(estimate), source or "configured"))
    if not snapshot.get("models"):
        lines.append("No model observations")
    for reserve in snapshot.get("reserves", []):
        if reserve["until"] > now:
            lines.append("RESERVE %s GPU%s %s GiB until %s (%s)" % (
                reserve["id"], reserve["gpu"], number(reserve["size_gb"]), expiry(reserve["until"]), reserve["by"],
            ))
    for lease in snapshot.get("leases", []):
        if lease.get("status") not in ("released", "confirmed"):
            lines.append("LEASE %s GPU%s %s GiB %s until %s" % (
                lease["model"], lease["gpu"], number(lease.get("budget_gb")), lease.get("status", "pending"), expiry(lease.get("expires_at")),
            ))
    for blocked in snapshot.get("blocked_by", []):
        lines.append("BLOCKED %s: %s" % (blocked["model"], blocked["reason"]))
    for error in snapshot.get("errors", []):
        lines.append("WARNING " + clean_text(error))
    lines.append("* default model | ? unknown | sampled %s%s" % (
        expiry(snapshot.get("sampled_at")), " | read-only" if snapshot.get("read_only") else "",
    ))
    return "\n".join(part for line in lines for part in wrap_line(line, width))


