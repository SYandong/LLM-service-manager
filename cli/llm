        size += len(raw) + 1
        if size > 262144:
            raise ClientError("Scheduler SSE frame exceeds 256 KiB")
        try:
            line = raw.decode("utf-8")
        except UnicodeError:
            raise ClientError("Scheduler SSE contains invalid UTF-8") from None
