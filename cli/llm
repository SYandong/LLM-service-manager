def event_lines(response):
    """Read available bytes without waiting for a full buffer; accept LF/CRLF/CR."""
    line, after_cr = bytearray(), False
    while True:
        chunk = response.read1(4096)
        if not chunk:
            return  # An incomplete line/event at EOF is replayed after reconnect.
        for value in chunk:
            if after_cr:
                after_cr = False
                if value == 10:
                    continue
            if value in (10, 13):
                yield bytes(line)
                line.clear()
                after_cr = value == 13
            else:
                line.append(value)
                if len(line) > 65536:
                    raise ClientError("Scheduler SSE line exceeds 64 KiB")


def iter_events(response):
