class EventReader:
    """One background subscription to scheduler SSE with a bounded delivery queue."""

    def __init__(self, client, *, stream_timeout=30, retry_delay=1, max_retry_delay=30, queue_size=256):
        self.client = client
        self.stream_timeout = positive_timeout(stream_timeout)
        self.retry_delay = positive_timeout(retry_delay)
        self.max_retry_delay = max(self.retry_delay, positive_timeout(max_retry_delay))
        if not isinstance(queue_size, int) or queue_size < 1:
            raise ClientError("Event queue size must be positive")
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._wake = threading.Event()
        self._queue = deque(maxlen=queue_size)
        self._cursor = 0
        self._generation = 0
        self._dropped = 0
        self._missed = 0
        self._status = "SSE connecting"
        self._socket = None
        self.thread = None
        self._notify_callback = None

    def set_notify(self, callback):
        """Optional thread-safe UI wake-up; callbacks must not touch widgets."""
        self._notify_callback = callback

    def _notify(self):
        callback = self._notify_callback
        if callback is not None:
            callback()

    def start(self):
        if self.thread is not None:
            raise ClientError("Event reader is already started")
        self.thread = threading.Thread(target=self._run, name="llm-scheduler-events", daemon=True)
        self.thread.start()

    def drain(self):
        with self._lock:
            result = {"generation": self._generation, "events": list(self._queue),
                      "status": self._status, "dropped": self._dropped,
                      "missed": self._missed, "cursor": self._cursor}
            self._queue.clear()
            return result

    def _interrupt(self):
        with self._lock:
            connection = self._socket
        if connection is not None:
            try:
                connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    def reset_cursor(self):
        """Call only after a known daemon restart, not on ordinary disconnects."""
        with self._lock:
            self._generation += 1
            self._cursor = 0
            self._queue.clear()
            self._dropped = 0
            self._missed = 0
            self._status = "SSE cursor reset after known restart"
        self._wake.set()
        self._interrupt()
        self._notify()

    def close(self, timeout=None):
        self._stop.set()
        self._wake.set()
        self._interrupt()
        if self.thread is not None:
            wait = self.client.timeout + self.stream_timeout + 1 if timeout is None else positive_timeout(timeout)
            self.thread.join(timeout=wait)
            return not self.thread.is_alive()
        return True

    def _run(self):
        delay = self.retry_delay
        while not self._stop.is_set():
            with self._lock:
                cursor, generation = self._cursor, self._generation
            response = None
            try:
                request = Request(self.client.url + "/v1/events?since=" + str(cursor),
                                  headers={"Accept": "text/event-stream", "Last-Event-ID": str(cursor)})
                response = self.client.opener(request, timeout=self.client.timeout)
                if response.headers.get_content_type() != "text/event-stream":
                    raise ClientError("Scheduler SSE response has an invalid content type")
