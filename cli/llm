        return 0
    except ClientError as exc:
        print("llm: " + clean_text(exc), file=sys.stderr)
        return 1
    except (KeyError, TypeError, ValueError, OverflowError):
        print("llm: Invalid scheduler state response; check the server API version", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
