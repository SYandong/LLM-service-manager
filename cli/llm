USAGE_COUNTS = ("requests", "input_tokens", "output_tokens")


def validate_usage(result, *, days=None, by=None):
    """Reject incomplete/inconsistent counts instead of manufacturing a total."""
    try:
        valid = (type(result.get("known")) is bool and type(result.get("days")) is int
                 and result["days"] > 0 and result.get("by") in ("container", "ip", "model")
                 and isinstance(result.get("rows"), (list, tuple))
                 and isinstance(result.get("totals"), dict))
        if not valid or (days is not None and result["days"] != days) or (by is not None and result["by"] != by):
            raise ValueError
        totals = result["totals"]
        if not result["known"]:
            if result["rows"] or any(key not in totals or totals[key] is not None for key in USAGE_COUNTS):
                raise ValueError
            return result
        for counts in [totals, *result["rows"]]:
            if any(type(counts.get(key)) is not int or counts[key] < 0 for key in USAGE_COUNTS):
                raise ValueError
        for row in result["rows"]:
            if not isinstance(row.get(result["by"]), str) or type(row.get("source_known")) is not bool:
                raise ValueError
        if any(sum(row[key] for row in result["rows"]) != totals[key] for key in USAGE_COUNTS):
            raise ValueError
    except (AttributeError, KeyError, TypeError, ValueError):
        raise ClientError("Invalid usage response: counts, grouping or totals are inconsistent") from None
    return result


def usage_attribution(row, by):
    if by == "model":
        return "not grouped"
    if not row["source_known"]:
        return "unknown"
    if by == "container" and row[by].startswith("ip:"):
        return "IP only"
    return "known"


def format_usage(result, width=100):
    validate_usage(result)
    width = max(1, width)
    lines = ["Usage: last %s days by %s" % (result["days"], result["by"])]
    if not result["known"]:
        lines.extend(["Unavailable: " + clean_text(result.get("error") or "source unavailable"),
                      "Requests ?  Input tokens ?  Output tokens ?"])
    else:
        rows, totals, by = result["rows"], result["totals"], result["by"]
        labels = ("REQUESTS", "INPUT TOKENS", "OUTPUT TOKENS")
        sizes = [max(len(label), *(len(str(item[key])) for item in [totals, *rows]))
                 for key, label in zip(USAGE_COUNTS, labels)]
        source_width = width - sum(sizes) - 11 - 8
        if source_width >= 12:
            lines.append("  ".join([fit(by.upper(), source_width),
                                    *(label.rjust(size) for label, size in zip(labels, sizes)), "ATTRIBUTION"]))
            for row in rows:
                lines.append("  ".join([fit(row[by], source_width),
                                        *(str(row[key]).rjust(size) for key, size in zip(USAGE_COUNTS, sizes)),
                                        usage_attribution(row, by)]))
            lines.append("  ".join([fit("TOTAL", source_width),
                                    *(str(totals[key]).rjust(size) for key, size in zip(USAGE_COUNTS, sizes))]))
        else:
            for row in rows:
                lines.extend(["%s (%s)" % (row[by], usage_attribution(row, by)),
                              "  Requests: %s" % row["requests"],
                              "  Input tokens: %s" % row["input_tokens"],
                              "  Output tokens: %s" % row["output_tokens"]])
            lines.extend(["TOTAL", "Requests: %s" % totals["requests"],
                          "Input tokens: %s" % totals["input_tokens"],
                          "Output tokens: %s" % totals["output_tokens"]])
        if not rows:
            lines.append("No requests in this window (source available)")
        lines.append("Attribution: not grouped by source" if by == "model" else
                     "Attribution: unknown = origin absent; IP only = container mapping unavailable")
    return "\n".join(part for line in lines for part in wrap_line(line, width))


